                                HorizontalOptions="Start"
                                VerticalOptions="Start"
                                WidthRequest="200"
                                HeightRequest="40"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10,10,10,10">
                                <Entry
                                    x:Name="HeatNumberEntry"
                                    Text="{Binding ActiveTicket.Tracked.VariableFields.HeatNumber}"/>
                            </Border>
                        </HorizontalStackLayout>
                    </HorizontalStackLayout>
                    <!-- Separator Bar -->
