<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:Datasources="clr-namespace:LotCoMPrinter.Models.Datasources"
             xmlns:ViewModels="clr-namespace:LotCoMPrinter.ViewModels"
             x:DataType="ViewModels:MainPageViewModel"
             x:Class="LotCoMPrinter.Views.MainPage">

    <!-- Customize NavigationPage Bar and Properties -->
    <NavigationPage.HasBackButton>
        <x:Boolean>False</x:Boolean>
    </NavigationPage.HasBackButton>
    <NavigationPage.HasNavigationBar>
        <x:Boolean>False</x:Boolean>
    </NavigationPage.HasNavigationBar>

    <!-- Merge and Consume Custom ResourceDictionaries -->
    <ContentPage.Resources>
        <!-- RecessedButton Styles -->
        <ResourceDictionary Source="/Resources/Styles/RecessedButton.xaml"/>
        <!-- GreenButton Styles -->
        <ResourceDictionary Source="/Resources/Styles/GreenButton.xaml"/>
        <!-- RedButton Styles -->
        <ResourceDictionary Source="/Resources/Styles/RedButton.xaml"/>
    </ContentPage.Resources>

    <!-- Main Layout Grid (Welcome Menu, Active Ticket, and Open Tickets) -->
    <Grid>
        <Grid.RowDefinitions>
            <!-- Main Layout Row -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <!-- Open Print Tickets Panel Column -->
            <ColumnDefinition Width="Auto"/>
            <!-- Welcome Menu / Active Print Ticket Column -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Open Print Tickets Panel Layout -->
        <Grid
            Grid.Row="0"
            Grid.Column="0"
            BackgroundColor="{AppThemeBinding Light={StaticResource Framing}, Dark={StaticResource FramingDark}}"
            WidthRequest="{Binding Options.OpenPrintTicketsPanelWidth}">
            <Grid.RowDefinitions>
                <!-- Header Row -->
                <RowDefinition Height="Auto"/>
                <!-- Body (ListView) Row -->
                <RowDefinition Height="*"/>
                <!-- Body Collapse/Raise Button Row -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <!-- Single Column for the Panel -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Panel Header Label -->
            <Label
                x:Name="OpenPrintTicketsHeaderLabel"
                IsVisible="{Binding Options.IsOpenPrintTicketsPanelShown}"
                Grid.Row="0"
                Grid.Column="0"
                Margin="0,20,0,0"
                Text="In-Process Labels"
                HorizontalOptions="Center"
                VerticalOptions="Start"/>
            <!-- Panel Body List -->
            <CollectionView
                Grid.Row="1"
                Grid.Column="0"
                x:Name="OpenPrintTicketsCollectionView"
                IsVisible="{Binding Options.IsOpenPrintTicketsPanelShown}"
                SelectionMode="Single"
                ItemsSource="{Binding OpenPrintTickets}"
                SelectedItem="{Binding SelectedPrintTicket}"
                SelectionChanged="OnOpenPrintTicketsCollectionViewSelectionChanged"
                Margin="10"
                HorizontalOptions="Start"
                VerticalOptions="Start"
                BackgroundColor="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource BackgroundDark}}">
                <CollectionView.ItemTemplate>
                    <DataTemplate
                        x:DataType="Datasources:PrintTicket">
                        <!-- Configurable ListView Grid Layout -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <!-- Process & Date Row -->
                                <RowDefinition Height="Auto"/>
                                <!-- Title & Shift Row -->
                                <RowDefinition Height="Auto"/>
                                <!-- Open Button Row -->
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <!-- Process / Title Column -->
                                <ColumnDefinition Width="*"/>
                                <!-- Date / Shift Column -->
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Process Label -->
                            <Label 
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,5,0,0"
                                Text="{Binding Process.FullName}"
                                FontSize="12"
                                HorizontalOptions="Start"
                                VerticalOptions="Center"/>
                            <!-- Date Label -->
                            <Label 
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="0,5,0,0"
                                Text="{Binding ProductionDateNoTime}"
                                FontSize="12"
                                HorizontalOptions="End"
                                VerticalOptions="Center"/>
                            <!-- Title Label -->
                            <Label
                                Grid.Row="1"
                                Grid.Column="0"
                                Margin="0,5,0,0"
                                Text="{Binding Title}"
                                FontSize="12"
                                HorizontalOptions="Start"
                                VerticalOptions="Center"/>
                            <!-- Shift Label -->
                            <Label
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="0,5,0,0"
                                Text="{Binding ProductionShift}"
                                FontSize="12"
                                HorizontalOptions="End"
                                VerticalOptions="Center"/>
                            <!-- Open Ticket Button -->
                            <Button
                                x:Name="OpenTicketFromListViewButton"
                                IsVisible="{Binding IsSelectedInList}"
                                Clicked="OnOpenPrintTicketFromListViewButtonClicked"
                                Grid.Row="2"
                                Grid.Column="1"
                                Margin="5"
                                Padding="0"
                                CharacterSpacing="0"
                                HorizontalOptions="End"
                                VerticalOptions="Center"
                                WidthRequest="50"
                                HeightRequest="25"
                                MinimumHeightRequest="25"
                                Text="Open >"
                                FontSize="10"/>
                            <!-- Bottom Border -->
                            <BoxView
                                Grid.Row="2"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Margin="0,5,0,0"
                                HeightRequest="1"
                                HorizontalOptions="Fill"
                                VerticalOptions="End"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Foreground}, Dark={StaticResource ForegroundDark}}"/>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <!-- Panel Collapse/Raise Button -->
            <Button
                x:Name="OpenPrintTicketsCollapseButton"
                Grid.Row="2"
                Grid.Column="0"
                Clicked="OnOpenPrintTicketsCollapseButtonClicked"
                Margin="20"
                Padding="10"
                Rotation="180"
                VerticalOptions="End"
                HorizontalOptions="End"
                HeightRequest="30"
                WidthRequest="30"
                CornerRadius="30"
                ImageSource="{AppThemeBinding Light=left_arrow_black.png, Dark=left_arrow_white.png}"/>
            <!-- Panel Left Border -->
            <BoxView
                x:Name="OpenPrintTicketsLeftBorder"
                Grid.Row="0"
                Grid.RowSpan="3"
                Grid.Column="0"
                WidthRequest="1"
                VerticalOptions="Fill"
                HorizontalOptions="End"
                BackgroundColor="{AppThemeBinding Light={StaticResource Foreground}, Dark={StaticResource ForegroundDark}}"/>
        </Grid>

        <!-- Welcome Menu Layout -->
        <Grid
            Grid.Row="0"
            Grid.Column="1"
            IsVisible="{Binding Options.IsWelcomeMenuShown}"
            BackgroundColor="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource BackgroundDark}}">
            <Grid.RowDefinitions>
                <!-- Header Row -->
                <RowDefinition Height="Auto"/>
                <!-- Body Row -->
                <RowDefinition Height="*"/>
                <!-- Footer Row -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- Welcome Menu Header -->
            <VerticalStackLayout
                Grid.Row="0"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                BackgroundColor="{AppThemeBinding Light={StaticResource Framing}, Dark={StaticResource FramingDark}}">
                <!-- Title Label -->
                <Label
                    Margin="20"
                    HorizontalOptions="Start"
                    VerticalOptions="Center"
                    FontSize="20"
                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                    Text="{Binding Options.WelcomeMenuTitleLabelText}"/>
            </VerticalStackLayout>
            <!-- Welcome Menu Body -->
            <HorizontalStackLayout
                Grid.Row="1"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                BackgroundColor="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource BackgroundDark}}">
                <!-- Sub-Title Label -->
                <Label
                    Margin="20"
                    HorizontalOptions="Start"
                    VerticalOptions="Start"
                    FontSize="14"
                    TextColor="{AppThemeBinding Light={StaticResource PrimaryText}, Dark={StaticResource PrimaryTextDark}}"
                    Text="{Binding Options.WelcomeMenuSubTitleLabelText}"/>
            </HorizontalStackLayout>
            <!-- Welcome Menu Footer -->
            <HorizontalStackLayout
                Grid.Row="2"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                BackgroundColor="{AppThemeBinding Light={StaticResource Framing}, Dark={StaticResource FramingDark}}">
                <!-- Start New Label Button -->
                <Button
                    x:Name="StartNewLabelButton"
                    Clicked="OnStartNewLabelButtonClicked"
                    IsVisible="{Binding Options.IsWelcomeMenuShown}"
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="20"
                    HorizontalOptions="Start"
                    VerticalOptions="End"
                    Text="Start New Label"/>
            </HorizontalStackLayout>
        </Grid>

        <!-- Active Print Ticket Layout -->
        <Grid
            x:Name="ActivePrintTicketLayout"
            Grid.Row="0"
            Grid.Column="1"
            IsVisible="{Binding Options.IsActivePrintTicketMenuShown}">
            <Grid.RowDefinitions>
                <!-- Header Panel Row -->
                <RowDefinition Height="Auto"/>
                <!-- Scrolling Body Panel Row -->
                <RowDefinition Height="*"/>
                <!-- Footer Panel Row -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- Header Panel -->
            <HorizontalStackLayout
                Grid.Row="0"
                x:Name="ActivePrintTicketLayoutHeader"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                BackgroundColor="{AppThemeBinding Light={StaticResource Framing}, Dark={StaticResource FramingDark}}">
                <!-- Header Row Label -->
                <Label
                    Margin="20"
                    HorizontalOptions="Start"
                    VerticalOptions="Center"
                    FontSize="20"
                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                    Text="{Binding ActiveTicket.Untracked.Title, StringFormat='Input for Label: {0}'}"/>
                <!-- Action Buttons Panel -->
                <HorizontalStackLayout
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill">
                    <!-- Panel Label -->
                    <Label
                        Text="Actions"
                        FontSize="12"
                        FontAttributes="Bold"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        Margin="0,0,20,0"/>
                    <!-- Close Button -->
                    <Button
                        x:Name="CloseActivePrintTicketButton"
                        Clicked="OnCloseActivePrintTicketButtonClicked"
                        Margin="5,0,0,0"
                        Padding="0"
                        CharacterSpacing="0"
                        WidthRequest="110"
                        HeightRequest="25"
                        MinimumHeightRequest="25"
                        HorizontalOptions="End"
                        VerticalOptions="Center"
                        Text="Cancel &amp; Close">
                    </Button>  
                    <!-- Save Button -->
                    <Button
                        x:Name="SaveActivePrintTicketButton"
                        Clicked="OnSaveActivePrintTicketButtonClicked"
                        Margin="5,0,0,0"
                        Padding="0"
                        CharacterSpacing="0"
                        WidthRequest="110"
                        HeightRequest="25"
                        MinimumHeightRequest="25"
                        HorizontalOptions="End"
                        VerticalOptions="Center"
                        Text="Save &amp; Close">
                    </Button>  
                    <!-- Delete Button -->
                    <Button
                        x:Name="DeleteActivePrintTicketButton"
                        Clicked="OnDeleteActivePrintTicketButtonClicked"
                        Margin="5,0,0,0"
                        Padding="0"
                        CharacterSpacing="0"
                        WidthRequest="110"
                        HeightRequest="25"
                        MinimumHeightRequest="25"
                        HorizontalOptions="End"
                        VerticalOptions="Center"
                        Text="Delete Label">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroupList>
                                <VisualStateGroup x:Name="RedStates">
                                    <VisualState x:Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Property="Style" Value="{StaticResource RedNormalStyle}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Property="Style" Value="{StaticResource RedDisabledStyle}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Property="Style" Value="{StaticResource RedPressedStyle}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Property="Style" Value="{StaticResource RedPointerOverStyle}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateGroupList>
                        </VisualStateManager.VisualStateGroups>
                    </Button>  
                    <!-- Finalize & Print Button -->
                    <Button
                        x:Name="PrintActivePrintTicketButton"
                        Clicked="OnPrintActivePrintTicketButtonClicked"
                        Margin="5,0,0,0"
                        Padding="0"
                        CharacterSpacing="0"
                        WidthRequest="110"
                        HeightRequest="25"
                        MinimumHeightRequest="25"
                        HorizontalOptions="End"
                        VerticalOptions="Center"
                        Text="Finalize &amp; Print">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroupList>
                                <VisualStateGroup x:Name="GreenStates">
                                    <VisualState x:Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Property="Style" Value="{StaticResource GreenNormalStyle}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Property="Style" Value="{StaticResource GreenDisabledStyle}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Property="Style" Value="{StaticResource GreenPressedStyle}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Property="Style" Value="{StaticResource GreenPointerOverStyle}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateGroupList>
                        </VisualStateManager.VisualStateGroups>
                    </Button>
                </HorizontalStackLayout>
            </HorizontalStackLayout>
            <!-- Scrolling Body Panel -->
            <ScrollView
                Grid.Row="1"
                x:Name="ActivePrintTicketLayoutBody"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                BackgroundColor="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource BackgroundDark}}">
                <VerticalStackLayout>
                    <!-- Initial Production Info Header Layout -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Title Row -->
                            <RowDefinition Height="Auto"/>
                            <!-- Process Row -->
                            <RowDefinition Height="Auto"/>
                            <!-- Part Row -->
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <!-- Title / Labels Column -->
                            <ColumnDefinition Width="Auto"/>
                            <!-- Process / Part Column -->
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- Title Label -->
                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Margin="20"
                            HorizontalOptions="Start"
                            VerticalOptions="Center"
                            FontSize="16"
                            TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                            Text="Initial Production Data"/>  
                        <!-- Process Field Label -->
                        <Label
                            Grid.Row="1"
                            Grid.Column="0"
                            FontSize="16"
                            TextColor="{AppThemeBinding Light={StaticResource PrimaryText}, Dark={StaticResource PrimaryTextDark}}"
                            Margin="20,0,0,10"
                            HorizontalOptions="Start"
                            VerticalOptions="Center"
                            Text="Process:"/>
                        <!-- Process Value Label -->
                        <Label
                            Grid.Row="1"
                            Grid.Column="1"
                            x:Name="ProcessLabel"
                            FontSize="16"
                            TextColor="{AppThemeBinding Light={StaticResource SecondaryText}, Dark={StaticResource SecondaryTextDark}}"
                            Margin="35,0,0,10"
                            HorizontalOptions="Start"
                            VerticalOptions="Center"
                            WidthRequest="300"
                            MinimumWidthRequest="300"
                            Text="{Binding ActiveTicket.Untracked.Process.FullName}"/>
                        <!-- Part Field Label -->
                        <Label
                            Grid.Row="2"
                            Grid.Column="0"
                            FontSize="16"
                            TextColor="{AppThemeBinding Light={StaticResource PrimaryText}, Dark={StaticResource PrimaryTextDark}}"
                            Margin="20,0,0,10"
                            HorizontalOptions="Start"
                            VerticalOptions="Center"
                            Text="Part:"/>
                        <!-- Part Value Label -->
                        <Label
                            Grid.Row="2"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            x:Name="PartLabel"
                            FontSize="16"
                            TextColor="{AppThemeBinding Light={StaticResource SecondaryText}, Dark={StaticResource SecondaryTextDark}}"
                            Margin="35,0,0,10"
                            HorizontalOptions="Start"
                            VerticalOptions="Center"
                            WidthRequest="300"
                            MinimumWidthRequest="300"
                            Text="{Binding ActiveTicket.Untracked.Part.GetInfo}"/>
                    </Grid>
                    <!-- Process/Part Separator Bar -->
                    <BoxView
                        Margin="0"
                        HeightRequest="1"
                        HorizontalOptions="Fill"
                        VerticalOptions="End"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Foreground}, Dark={StaticResource ForegroundDark}}"/>
                    <!-- Production Date Input -->
                    <HorizontalStackLayout
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill">
                        <!-- Input Label -->
                        <Label
                            x:Name="ProductionDateLabel"
                            Margin="20,10,10,10"
                            HorizontalOptions="Start"
                            VerticalOptions="Center"
                            WidthRequest="80"
                            MinimumWidthRequest="80"
                            Text="Production Date"/>
                        <!-- Input DatePicker Control and Border -->
                        <Border
                            x:Name="ProductionDateControl"
                            Margin="0,10,0,10"
                            HorizontalOptions="Start"
                            VerticalOptions="Start"
                            WidthRequest="200"
                            HeightRequest="40"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10,10,10,10">
                            <DatePicker
                                x:Name="ProductionDatePicker"
                                IsEnabled="False"
                                Date="{Binding ActiveTicket.Untracked.ProductionDate}"
                                WidthRequest="195"/>
                        </Border>
                    </HorizontalStackLayout>
                    <!-- Initial Shift/Quantity/Operator Layout -->
                    <!-- Enforces Alignment with Dynamic Display of Variably-Required Fields Below -->
                    <HorizontalStackLayout>
                        <!-- Shift Number Input -->
                        <HorizontalStackLayout>
                            <!-- Input Label -->
                            <Label
                                Margin="20,10,10,10"
                                x:Name="ShiftLabel"
                                HorizontalOptions="Start"
                                VerticalOptions="Center"
                                WidthRequest="80"
                                MinimumWidthRequest="80"
                                Text="Shift"/>
                            <!-- Input Entry Control and Border -->
                            <Border
                                x:Name="ShiftControl"
                                Margin="0,10,0,10"
                                HorizontalOptions="Start"
                                VerticalOptions="Start"
                                WidthRequest="200"
                                HeightRequest="40"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10,10,10,10">
                                <Picker
                                    x:Name="ShiftPicker"
                                    IsEnabled="False"
                                    SelectedItem="{Binding ActiveTicket.Untracked.ProductionShift}">
                                    <Picker.ItemsSource>
                                        <x:Array Type="{x:Type x:Int32}">
                                            <x:Int32>1</x:Int32>
                                            <x:Int32>2</x:Int32>
                                            <x:Int32>3</x:Int32>
                                        </x:Array>
                                    </Picker.ItemsSource>
                                </Picker>
                            </Border>
                        </HorizontalStackLayout>
                        <!-- Quantity Input -->
                        <HorizontalStackLayout>
                            <!-- Input Label -->
                            <Label
                                x:Name="QuantityLabel"
                                Margin="20,10,10,10"
                                HorizontalOptions="Start"
                                VerticalOptions="Center"
                                WidthRequest="80"
                                MinimumWidthRequest="80"
                                Text="Quantity"/>
                            <!-- Input Entry Control and Border -->
                            <Border
                                x:Name="QuantityControl"
                                Margin="0,10,0,10"
                                HorizontalOptions="Start"
                                VerticalOptions="Start"
                                WidthRequest="200"
                                HeightRequest="40"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10,10,10,10">
                                <Entry
                                    x:Name="QuantityEntry"
                                    Text="{Binding ActiveTicket.Tracked.ProductionQuantity}"/>
                            </Border>
                        </HorizontalStackLayout>
                        <!-- Operator Input -->
                        <HorizontalStackLayout>
                            <!-- Input Label -->
                            <Label
                                x:Name="OperatorLabel"
                                Margin="20,10,10,10"
                                HorizontalOptions="Start"
                                VerticalOptions="Center"
                                WidthRequest="80"
                                MinimumWidthRequest="80"
                                Text="Operator"/>
                            <!-- Input Entry Control and Border -->
                            <Border
                                x:Name="OperatorControl"
                                Margin="0,10,0,10"
                                HorizontalOptions="Start"
                                VerticalOptions="Start"
                                WidthRequest="200"
                                HeightRequest="40"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10,10,10,10">
                                <Entry
                                    x:Name="OperatorEntry"
                                    IsEnabled="False"
                                    Text="{Binding ActiveTicket.Untracked.ProductionOperator}"
                                    MaxLength="3"/>
                            </Border>
                        </HorizontalStackLayout>
                    </HorizontalStackLayout>
                    <!-- Variable Fields Horizontal Stack Layout -->
                    <!-- Supports Dynamic Display of Variably-Required Fields -->
                    <HorizontalStackLayout
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill">
                        <!-- JBK Input Layout -->
                        <HorizontalStackLayout
                            IsVisible="{Binding ActiveTicket.Untracked.Process.RequiredFields.JBKNumber}">
                            <!-- JBK Input Label -->
                            <Label
                                x:Name="JBKNumberLabel"
                                Margin="20,10,10,20"
                                HorizontalOptions="Start"
                                VerticalOptions="Center"
                                WidthRequest="80"
                                MinimumWidthRequest="80"
                                Text="JBK #"/>
                            <!-- JBK Input Entry Control and Border -->
                            <Border
                                x:Name="JBKNumberControl"
                                Margin="0,10,0,20"
                                HorizontalOptions="Start"
                                VerticalOptions="Start"
                                WidthRequest="200"
                                HeightRequest="40"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10,10,10,10">
                                <Entry
                                    x:Name="JBKNumberEntry"
                                    IsEnabled="{Binding ActiveTicket.Untracked.IsPassThrough}"
                                    Text="{Binding ActiveTicket.Tracked.VariableFields.JBKNumber}"
                                    MaxLength="3"/>
                            </Border>
                        </HorizontalStackLayout>
                        <!-- Lot Input Layout -->
                        <HorizontalStackLayout
                            IsVisible="{Binding ActiveTicket.Untracked.Process.RequiredFields.LotNumber}">
                            <!-- Lot Input Label -->
                            <Label
                                x:Name="LotNumberLabel"
                                Margin="20,10,10,20"
                                HorizontalOptions="Start"
                                VerticalOptions="Center"
                                WidthRequest="80"
                                MinimumWidthRequest="80"
                                Text="Lot #"/>
                            <!-- Lot Input Entry Control and Border -->
                            <Border
                                x:Name="LotNumberControl"
                                Margin="0,10,0,20"
                                HorizontalOptions="Start"
                                VerticalOptions="Start"
                                WidthRequest="200"
                                HeightRequest="40"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10,10,10,10">
                                <Entry
                                    x:Name="LotNumberEntry"
                                    IsEnabled="{Binding ActiveTicket.Untracked.IsPassThrough}"
                                    Text="{Binding ActiveTicket.Tracked.VariableFields.LotNumber}"
                                    MaxLength="9"/>
                            </Border>
                        </HorizontalStackLayout>
                        <!-- Deburr JBK Input Layout -->
                        <HorizontalStackLayout
                            IsVisible="{Binding ActiveTicket.Untracked.Process.RequiredFields.DeburrJBKNumber}">
                            <!-- Input Label -->
                            <Label
                                x:Name="DeburrJBKNumberLabel"
                                Margin="20,10,10,20"
                                HorizontalOptions="Start"
                                VerticalOptions="Center"
                                WidthRequest="80"
                                MinimumWidthRequest="80"
                                Text="Deburr JBK #"/>
                            <!-- Input Entry Control and Border -->
                            <Border
                                x:Name="DeburrJBKNumberControl"
                                Margin="0,10,0,20"
                                HorizontalOptions="Start"
                                VerticalOptions="Start"
                                WidthRequest="200"
                                HeightRequest="40"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10,10,10,10">
                                <Entry
                                    x:Name="DeburrJBKNumberEntry"
                                    Text="{Binding ActiveTicket.Tracked.VariableFields.DeburrJBKNumber}"
                                    MaxLength="3"/>
                            </Border>
                        </HorizontalStackLayout>
                        <!-- Die Number Input Layout -->
                        <HorizontalStackLayout
                            IsVisible="{Binding ActiveTicket.Untracked.Process.RequiredFields.DieNumber}">
                            <!-- Input Label -->
                            <Label
                                x:Name="DieNumberLabel"
                                Margin="20,10,10,20"
                                HorizontalOptions="Start"
                                VerticalOptions="Center"
                                WidthRequest="80"
                                MinimumWidthRequest="80"
                                Text="Die #"/>
                            <!-- Input Entry Control and Border -->
                            <Border
                                x:Name="DieNumberControl"
                                Margin="0,10,0,20"
                                HorizontalOptions="Start"
                                VerticalOptions="Start"
                                WidthRequest="200"
                                HeightRequest="40"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10,10,10,10">
                                <Entry
                                    x:Name="DieNumberEntry"
                                    Text="{Binding ActiveTicket.Tracked.VariableFields.DieNumber}"
                                    MaxLength="3"/>
                            </Border>
                        </HorizontalStackLayout>
                        <!-- Model Input Layout -->
                        <HorizontalStackLayout
                            IsVisible="{Binding ActiveTicket.Untracked.Process.RequiredFields.ModelNumber}">
                            <!-- Input Label -->
                            <Label
                                x:Name="ModelNumberLabel"
                                Margin="20,10,10,20"
                                HorizontalOptions="Start"
                                VerticalOptions="Center"
                                WidthRequest="80"
                                MinimumWidthRequest="80"
                                Text="Model #"/>
                            <!-- Input Entry Control and Border -->
                            <Border
                                x:Name="ModelNumberControl"
                                Margin="0,10,0,20"
                                HorizontalOptions="Start"
                                VerticalOptions="Start"
                                WidthRequest="200"
                                HeightRequest="40"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10,10,10,10">
                                <Entry
                                    x:Name="ModelNumberEntry"
                                    Text="{Binding ActiveTicket.Tracked.VariableFields.ModelNumber}"
                                    MaxLength="3"/>
                            </Border>
                        </HorizontalStackLayout>
                        <!-- Heat Number Input Layout -->
                        <HorizontalStackLayout
                            IsVisible="{Binding ActiveTicket.Untracked.Process.RequiredFields.HeatNumber}">
