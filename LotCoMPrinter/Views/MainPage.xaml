<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:Datasources="clr-namespace:LotCoMPrinter.Models.Datasources"
             xmlns:ViewModels="clr-namespace:LotCoMPrinter.ViewModels"
             x:DataType="ViewModels:MainPageViewModel"
             x:Class="LotCoMPrinter.Views.MainPage">

    <!-- Customize NavigationPage Bar and Properties -->
    <NavigationPage.HasBackButton>
        <x:Boolean>False</x:Boolean>
    </NavigationPage.HasBackButton>
    <NavigationPage.HasNavigationBar>
        <x:Boolean>False</x:Boolean>
    </NavigationPage.HasNavigationBar>

    <!-- Merge and Consume Custom ResourceDictionaries -->
    <ContentPage.Resources>
        <!-- RecessedButton Styles -->
        <ResourceDictionary Source="/Resources/Styles/RecessedButton.xaml"/>
        <!-- GreenButton Styles -->
        <ResourceDictionary Source="/Resources/Styles/GreenButton.xaml"/>
        <!-- RedButton Styles -->
        <ResourceDictionary Source="/Resources/Styles/RedButton.xaml"/>
    </ContentPage.Resources>

    <!-- Main Layout Grid (Welcome Menu, Active Ticket, and Open Tickets) -->
    <Grid>
        <Grid.RowDefinitions>
            <!-- Main Layout Row -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <!-- Open Print Tickets Panel Column -->
            <ColumnDefinition Width="Auto"/>
            <!-- Welcome Menu / Active Print Ticket Column -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Open Print Tickets Panel Layout -->
        <Grid
            Grid.Row="0"
            Grid.Column="0"
            BackgroundColor="{AppThemeBinding Light={StaticResource Framing}, Dark={StaticResource FramingDark}}"
            WidthRequest="{Binding Options.OpenPrintTicketsPanelWidth}">
            <Grid.RowDefinitions>
                <!-- Header Row -->
                <RowDefinition Height="Auto"/>
                <!-- Body (ListView) Row -->
                <RowDefinition Height="*"/>
                <!-- Body Collapse/Raise Button Row -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <!-- Single Column for the Panel -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Panel Header Label -->
            <Label
                x:Name="OpenPrintTicketsHeaderLabel"
                IsVisible="{Binding Options.IsOpenPrintTicketsPanelShown}"
                Grid.Row="0"
                Grid.Column="0"
                Margin="0,20,0,0"
                Text="In-Process Labels"
                HorizontalOptions="Center"
                VerticalOptions="Start"/>
            <!-- Panel Body List -->
            <ListView
                x:Name="OpenPrintTicketsListView"
                IsVisible="{Binding Options.IsOpenPrintTicketsPanelShown}"
                SelectedItem="{Binding Options.SelectedPrintTicketIndex}"
                ItemsSource="{Binding OpenPrintTickets}"
                ItemSelected="OnOpenPrintTicketsListViewItemSelected"
                Grid.Row="1"
                Grid.Column="0"
                Margin="10"
                HorizontalOptions="Start"
                VerticalOptions="Start"
                BackgroundColor="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource BackgroundDark}}">
                <ListView.ItemTemplate>
                    <DataTemplate
                        x:DataType="Datasources:PrintTicket">
                        <ViewCell>
                            <!-- Configurable ListView Grid Layout -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <!-- Process & Date Row -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- Title & Shift Row -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- Open Button Row -->
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <!-- Process / Title Column -->
                                    <ColumnDefinition Width="*"/>
                                    <!-- Date / Shift Column -->
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- Process Label -->
                                <Label 
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="0,5,0,0"
                                    Text="{Binding Process.FullName}"
                                    FontSize="12"
                                    HorizontalOptions="Start"
                                    VerticalOptions="Center"/>
                                <!-- Date Label -->
                                <Label 
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="0,5,0,0"
                                    Text="{Binding ProductionDateNoTime}"
                                    FontSize="12"
                                    HorizontalOptions="End"
                                    VerticalOptions="Center"/>
                                <!-- Title Label -->
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,5,0,0"
                                    Text="{Binding Title}"
                                    FontSize="12"
                                    HorizontalOptions="Start"
                                    VerticalOptions="Center"/>
                                <!-- Shift Label -->
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="0,5,0,0"
                                    Text="{Binding ProductionShift}"
                                    FontSize="12"
                                    HorizontalOptions="End"
                                    VerticalOptions="Center"/>
                                <!-- Open Ticket Button -->
                                <Button
                                    x:Name="OpenTicketFromListViewButton"
                                    IsVisible="{Binding IsSelectedInList}"
                                    Clicked="OnOpenPrintTicketFromListViewButtonClicked"
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Margin="5"
                                    Padding="0"
                                    CharacterSpacing="0"
                                    HorizontalOptions="End"
                                    VerticalOptions="Center"
                                    WidthRequest="50"
                                    HeightRequest="25"
                                    MinimumHeightRequest="25"
                                    Text="Open >"
                                    FontSize="10"/>
                                <!-- Bottom Border -->
                                <BoxView
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Margin="0,5,0,0"
                                    HeightRequest="1"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="End"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Foreground}, Dark={StaticResource ForegroundDark}}"/>
                            </Grid>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <!-- Panel Collapse/Raise Button -->
            <Button
                x:Name="OpenPrintTicketsCollapseButton"
                Grid.Row="2"
                Grid.Column="0"
                Clicked="OnOpenPrintTicketsCollapseButtonClicked"
                Margin="20"
                Padding="10"
                Rotation="180"
                VerticalOptions="End"
                HorizontalOptions="End"
                HeightRequest="30"
                WidthRequest="30"
                CornerRadius="30"
                ImageSource="{AppThemeBinding Light=left_arrow_black.png, Dark=left_arrow_white.png}"/>
            <!-- Panel Left Border -->
            <BoxView
                x:Name="OpenPrintTicketsLeftBorder"
                Grid.Row="0"
                Grid.RowSpan="3"
                Grid.Column="0"
                WidthRequest="1"
                VerticalOptions="Fill"
                HorizontalOptions="End"
                BackgroundColor="{AppThemeBinding Light={StaticResource Foreground}, Dark={StaticResource ForegroundDark}}"/>
        </Grid>

        <!-- Welcome Menu Layout -->
        <Grid
            Grid.Row="0"
            Grid.Column="1"
            IsVisible="{Binding Options.IsWelcomeMenuShown}"
            BackgroundColor="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource BackgroundDark}}">
            <Grid.RowDefinitions>
                <!-- Header Row -->
                <RowDefinition Height="Auto"/>
                <!-- Body Row -->
                <RowDefinition Height="*"/>
                <!-- Footer Row -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- Welcome Menu Header -->
            <VerticalStackLayout
                Grid.Row="0"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                BackgroundColor="{AppThemeBinding Light={StaticResource Framing}, Dark={StaticResource FramingDark}}">
                <!-- Title Label -->
                <Label
                    Margin="20"
                    HorizontalOptions="Start"
                    VerticalOptions="Center"
                    FontSize="20"
                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                    Text="{Binding Options.WelcomeMenuTitleLabelText}"/>
            </VerticalStackLayout>
            <!-- Welcome Menu Body -->
            <HorizontalStackLayout
                Grid.Row="1"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                BackgroundColor="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource BackgroundDark}}">
                <!-- Sub-Title Label -->
                <Label
                    Margin="20"
                    HorizontalOptions="Start"
                    VerticalOptions="Start"
                    FontSize="14"
                    TextColor="{AppThemeBinding Light={StaticResource PrimaryText}, Dark={StaticResource PrimaryTextDark}}"
                    Text="{Binding Options.WelcomeMenuSubTitleLabelText}"/>
            </HorizontalStackLayout>
            <!-- Welcome Menu Footer -->
            <HorizontalStackLayout
                Grid.Row="2"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                BackgroundColor="{AppThemeBinding Light={StaticResource Framing}, Dark={StaticResource FramingDark}}">
                <!-- Start New Label Button -->
                <Button
                    x:Name="StartNewLabelButton"
                    Clicked="OnStartNewLabelButtonClicked"
                    IsVisible="{Binding Options.IsWelcomeMenuShown}"
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="20"
                    HorizontalOptions="Start"
                    VerticalOptions="End"
                    Text="Start New Label"/>
            </HorizontalStackLayout>
        </Grid>

        <!-- Active Print Ticket Layout -->
        <ScrollView
            x:Name="ActivePrintTicketLayout"
            Grid.Row="0"
            Grid.Column="1"
            IsVisible="{Binding Options.IsActivePrintTicketMenuShown}">
            <!-- Layout Grid -->
            <Grid
                BackgroundColor="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource BackgroundDark}}">
                <Grid.RowDefinitions>
                    <!-- Header Row -->
                    <RowDefinition Height="Auto"/>
                    <!-- Process Input Row -->
                    <RowDefinition Height="Auto"/>
                    <!-- Part Input Row -->
                    <RowDefinition Height="Auto"/>
                    <!-- Production Date Input Row -->
                    <RowDefinition Height="Auto"/>
                    <!-- Shift / Quantity / Operator Input Row -->
                    <RowDefinition Height="Auto"/>
                    <!-- Variable Fields Input Row -->
                    <RowDefinition Height="Auto"/>
                    <!-- Separator Row -->
                    <RowDefinition Height="Auto"/>
                    <!-- First Partial Production Dataset Input Row -->
                    <RowDefinition Height="Auto"/>
                    <!-- Separator Row -->
                    <RowDefinition Height="Auto"/>
                    <!-- Second Partial Production Dataset Input Row -->
                    <RowDefinition Height="Auto"/>
                    <!-- Add Partial Production Dataset Button Row -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <!-- Main Column -->
                    <ColumnDefinition Width="*"/>
                    <!-- Print Button Column -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Close Button Column -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Header Fill -->
                <HorizontalStackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Framing}, Dark={StaticResource FramingDark}}">
                </HorizontalStackLayout>
                <!-- Header Row Label -->
                <Label
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="20"
                    HorizontalOptions="Start"
                    VerticalOptions="Center"
                    FontSize="20"
                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                    Text="{Binding ActivePrintTicket.Title, StringFormat='Input for Label: {0}'}"/>
                <!-- Action Buttons Panel -->
                <HorizontalStackLayout
                    Grid.Row="0"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    HorizontalOptions="End"
                    VerticalOptions="Center"
                    Margin="30">
                    <!-- Panel Label -->
                    <Label
                        Text="Actions"
                        FontSize="12"
                        FontAttributes="Bold"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        Margin="0,0,20,0"/>
                    <!-- Delete Button -->
                    <Button
                        x:Name="DeleteActivePrintTicketButton"
                        Clicked="OnCloseActivePrintTicketButtonClicked"
                        Margin="5,0,0,0"
                        Padding="0"
                        CharacterSpacing="0"
                        WidthRequest="110"
                        HeightRequest="25"
                        MinimumHeightRequest="25"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        Text="Delete Label">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroupList>
                                <VisualStateGroup x:Name="RedStates">
                                    <VisualState x:Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Property="Style" Value="{StaticResource RedNormalStyle}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Property="Style" Value="{StaticResource RedDisabledStyle}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Property="Style" Value="{StaticResource RedPressedStyle}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Property="Style" Value="{StaticResource RedPointerOverStyle}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateGroupList>
                        </VisualStateManager.VisualStateGroups>
                    </Button>  
                    <!-- Close Button -->
                    <Button
                        x:Name="CloseActivePrintTicketButton"
                        Clicked="OnCloseActivePrintTicketButtonClicked"
                        Margin="5,0,0,0"
                        Padding="0"
                        CharacterSpacing="0"
                        WidthRequest="110"
                        HeightRequest="25"
                        MinimumHeightRequest="25"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        Text="Save &amp; Close">
                    </Button>  
                    <!-- Finalize & Print Button -->
                    <Button
                        x:Name="FinalizeActivePrintTicketButton"
                        Margin="5,0,0,0"
                        Padding="0"
                        CharacterSpacing="0"
                        WidthRequest="110"
                        HeightRequest="25"
                        MinimumHeightRequest="25"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        Text="Finalize &amp; Print">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroupList>
                                <VisualStateGroup x:Name="GreenStates">
                                    <VisualState x:Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Property="Style" Value="{StaticResource GreenNormalStyle}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Property="Style" Value="{StaticResource GreenDisabledStyle}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Property="Style" Value="{StaticResource GreenPressedStyle}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Property="Style" Value="{StaticResource GreenPointerOverStyle}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateGroupList>
                        </VisualStateManager.VisualStateGroups>
                    </Button>
                </HorizontalStackLayout>
                <!-- Initial Production Info Header Layout -->
                <Grid
                    Grid.Row="1"
                    Grid.Column="0">
                    <Grid.RowDefinitions>
                        <!-- Title Row -->
                        <RowDefinition Height="Auto"/>
                        <!-- Process Row -->
                        <RowDefinition Height="Auto"/>
                        <!-- Part Row -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <!-- Title / Labels Column -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Process / Part Column -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Title Label -->
                    <Label
                        Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Margin="20"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        FontSize="16"
                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                        Text="Initial Production Data"/>  
                    <!-- Process Field Label -->
                    <Label
                        Grid.Row="1"
                        Grid.Column="0"
                        FontSize="16"
                        TextColor="{AppThemeBinding Light={StaticResource PrimaryText}, Dark={StaticResource PrimaryTextDark}}"
                        Margin="20,0,0,10"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        Text="Process:"/>
                    <!-- Process Value Label -->
                    <Label
                        Grid.Row="1"
                        Grid.Column="1"
                        x:Name="ProcessLabel"
                        FontSize="16"
                        TextColor="{AppThemeBinding Light={StaticResource SecondaryText}, Dark={StaticResource SecondaryTextDark}}"
                        Margin="35,0,0,10"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        WidthRequest="300"
                        MinimumWidthRequest="300"
                        Text="{Binding ActivePrintTicket.Process.FullName}"/>
                    <!-- Part Field Label -->
                    <Label
                        Grid.Row="2"
                        Grid.Column="0"
                        FontSize="16"
                        TextColor="{AppThemeBinding Light={StaticResource PrimaryText}, Dark={StaticResource PrimaryTextDark}}"
                        Margin="20,0,0,10"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        Text="Part:"/>
                    <!-- Part Value Label -->
                    <Label
                        Grid.Row="2"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        x:Name="PartLabel"
                        FontSize="16"
                        TextColor="{AppThemeBinding Light={StaticResource SecondaryText}, Dark={StaticResource SecondaryTextDark}}"
                        Margin="35,0,0,10"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        WidthRequest="300"
                        MinimumWidthRequest="300"
                        Text="{Binding ActivePrintTicket.Part.GetInfo}"/>
                </Grid>
                
                <!-- Process/Part Separator Bar -->
                <BoxView
                    Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Margin="0"
                    HeightRequest="1"
                    HorizontalOptions="Fill"
                    VerticalOptions="End"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Foreground}, Dark={StaticResource ForegroundDark}}"/>
                <!-- Production Date Input -->
                <HorizontalStackLayout
                    Grid.Row="3"
                    Grid.Column="0"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill">
                    <!-- Input Label -->
                    <Label
                        x:Name="ProductionDateLabel"
                        Margin="20,10,10,10"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        WidthRequest="80"
                        MinimumWidthRequest="80"
                        Text="Production Date"/>
                    <!-- Input DatePicker Control and Border -->
                    <Border
                        x:Name="ProductionDateControl"
                        Margin="0,10,0,10"
                        HorizontalOptions="Start"
                        VerticalOptions="Start"
                        WidthRequest="200"
                        HeightRequest="40"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10,10,10,10">
                        <DatePicker
                            x:Name="ProductionDatePicker"
                            IsEnabled="False"
                            Date="{Binding ActivePrintTicket.ProductionDate}"
                            WidthRequest="195"/>
                    </Border>
                </HorizontalStackLayout>

                <!-- Initial Shift/Quantity/Operator Layout -->
                <!-- Enforces Alignment with Dynamic Display of Variably-Required Fields Below -->
                <HorizontalStackLayout
                    Grid.Row="4"
                    Grid.Column="0"
                    Grid.ColumnSpan="3">
                    <!-- Shift Number Input -->
                    <HorizontalStackLayout>
                        <!-- Input Label -->
                        <Label
                            Margin="20,10,10,10"
                            x:Name="ShiftLabel"
                            HorizontalOptions="Start"
                            VerticalOptions="Center"
                            WidthRequest="80"
                            MinimumWidthRequest="80"
                            Text="Shift"/>
                        <!-- Input Entry Control and Border -->
                        <Border
                            x:Name="ShiftControl"
                            Margin="0,10,0,10"
                            HorizontalOptions="Start"
                            VerticalOptions="Start"
                            WidthRequest="200"
                            HeightRequest="40"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10,10,10,10">
                            <Picker
                                x:Name="ShiftPicker"
                                IsEnabled="False"
                                SelectedItem="{Binding ActivePrintTicket.ProductionShift}">
                                <Picker.ItemsSource>
                                    <x:Array Type="{x:Type x:Int32}">
                                        <x:Int32>1</x:Int32>
                                        <x:Int32>2</x:Int32>
                                        <x:Int32>3</x:Int32>
                                    </x:Array>
                                </Picker.ItemsSource>
                            </Picker>
                        </Border>
                    </HorizontalStackLayout>
                    <!-- Quantity Input -->
                    <HorizontalStackLayout>
                        <!-- Input Label -->
                        <Label
                            x:Name="QuantityLabel"
                            Margin="20,10,10,10"
                            HorizontalOptions="Start"
                            VerticalOptions="Center"
                            WidthRequest="80"
                            MinimumWidthRequest="80"
                            Text="Quantity"/>
                        <!-- Input Entry Control and Border -->
                        <Border
                            x:Name="QuantityControl"
                            Margin="0,10,0,10"
                            HorizontalOptions="Start"
                            VerticalOptions="Start"
                            WidthRequest="200"
                            HeightRequest="40"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10,10,10,10">
                            <Entry
                                x:Name="QuantityEntry"
                                Text="{Binding ActivePrintTicket.ProductionQuantity}"/>
                        </Border>
                    </HorizontalStackLayout>
                    <!-- Operator Input -->
                    <HorizontalStackLayout>
                        <!-- Input Label -->
                        <Label
                            x:Name="OperatorLabel"
                            Margin="20,10,10,10"
                            HorizontalOptions="Start"
                            VerticalOptions="Center"
                            WidthRequest="80"
                            MinimumWidthRequest="80"
                            Text="Operator"/>
                        <!-- Input Entry Control and Border -->
                        <Border
                            x:Name="OperatorControl"
                            Margin="0,10,0,10"
                            HorizontalOptions="Start"
                            VerticalOptions="Start"
                            WidthRequest="200"
                            HeightRequest="40"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10,10,10,10">
                            <Entry
                                x:Name="OperatorEntry"
                                IsEnabled="False"
                                Text="{Binding ActivePrintTicket.ProductionOperator}"
                                MaxLength="3"/>
                        </Border>
                    </HorizontalStackLayout>
                </HorizontalStackLayout>

                <!-- Variable Fields Horizontal Stack Layout -->
                <!-- Supports Dynamic Display of Variably-Required Fields -->
                <HorizontalStackLayout
                    Grid.Row="5"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill">
                    <!-- JBK Input Layout -->
                    <HorizontalStackLayout
                        IsVisible="{Binding ActivePrintTicket.Process.RequiredFields.JBKNumber}">
                        <!-- JBK Input Label -->
                        <Label
                            x:Name="JBKNumberLabel"
                            Margin="20,10,10,20"
                            HorizontalOptions="Start"
                            VerticalOptions="Center"
                            WidthRequest="80"
                            MinimumWidthRequest="80"
                            Text="JBK #"/>
                        <!-- JBK Input Entry Control and Border -->
                        <Border
                            x:Name="JBKNumberControl"
                            Margin="0,10,0,20"
                            HorizontalOptions="Start"
                            VerticalOptions="Start"
                            WidthRequest="200"
                            HeightRequest="40"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10,10,10,10">
                            <Entry
                                x:Name="JBKNumberEntry"
                                IsEnabled="{Binding ActivePrintTicket.IsPassThrough}"
                                Text="{Binding ActivePrintTicket.VariableFields.JBKNumber}"
                                MaxLength="3"/>
                        </Border>
                    </HorizontalStackLayout>
                    <!-- Lot Input Layout -->
                    <HorizontalStackLayout
                        IsVisible="{Binding ActivePrintTicket.Process.RequiredFields.LotNumber}">
                        <!-- Lot Input Label -->
                        <Label
                            x:Name="LotNumberLabel"
                            Margin="20,10,10,20"
                            HorizontalOptions="Start"
                            VerticalOptions="Center"
                            WidthRequest="80"
                            MinimumWidthRequest="80"
                            Text="Lot #"/>
                        <!-- Lot Input Entry Control and Border -->
                        <Border
                            x:Name="LotNumberControl"
                            Margin="0,10,0,20"
                            HorizontalOptions="Start"
                            VerticalOptions="Start"
                            WidthRequest="200"
                            HeightRequest="40"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10,10,10,10">
                            <Entry
                                x:Name="LotNumberEntry"
                                IsEnabled="{Binding ActivePrintTicket.IsPassThrough}"
                                Text="{Binding ActivePrintTicket.VariableFields.LotNumber}"
                                MaxLength="9"/>
                        </Border>
                    </HorizontalStackLayout>
                    <!-- Deburr JBK Input Layout -->
                    <HorizontalStackLayout
                        IsVisible="{Binding ActivePrintTicket.Process.RequiredFields.DeburrJBKNumber}">
                        <!-- Input Label -->
                        <Label
                            x:Name="DeburrJBKNumberLabel"
                            Margin="20,10,10,20"
                            HorizontalOptions="Start"
                            VerticalOptions="Center"
                            WidthRequest="80"
                            MinimumWidthRequest="80"
                            Text="Deburr JBK #"/>
                        <!-- Input Entry Control and Border -->
                        <Border
                            x:Name="DeburrJBKNumberControl"
                            Margin="0,10,0,20"
                            HorizontalOptions="Start"
                            VerticalOptions="Start"
                            WidthRequest="200"
                            HeightRequest="40"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10,10,10,10">
                            <Entry
                                x:Name="DeburrJBKNumberEntry"
                                Text="{Binding ActivePrintTicket.VariableFields.DeburrJBKNumber}"
                                MaxLength="3"/>
                        </Border>
                    </HorizontalStackLayout>
                    <!-- Die Number Input Layout -->
                    <HorizontalStackLayout
                        IsVisible="{Binding ActivePrintTicket.Process.RequiredFields.DieNumber}">
                        <!-- Input Label -->
                        <Label
                            x:Name="DieNumberLabel"
                            Margin="20,10,10,20"
                            HorizontalOptions="Start"
                            VerticalOptions="Center"
                            WidthRequest="80"
                            MinimumWidthRequest="80"
                            Text="Die #"/>
                        <!-- Input Entry Control and Border -->
                        <Border
                            x:Name="DieNumberControl"
                            Margin="0,10,0,20"
                            HorizontalOptions="Start"
                            VerticalOptions="Start"
                            WidthRequest="200"
                            HeightRequest="40"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10,10,10,10">
                            <Entry
                                x:Name="DieNumberEntry"
                                Text="{Binding ActivePrintTicket.VariableFields.DieNumber}"
                                MaxLength="3"/>
                        </Border>
                    </HorizontalStackLayout>
                    <!-- Model Input Layout -->
                    <HorizontalStackLayout
                        IsVisible="{Binding ActivePrintTicket.Process.RequiredFields.ModelNumber}">
                        <!-- Input Label -->
                        <Label
                            x:Name="ModelNumberLabel"
                            Margin="20,10,10,20"
                            HorizontalOptions="Start"
                            VerticalOptions="Center"
                            WidthRequest="80"
                            MinimumWidthRequest="80"
                            Text="Model #"/>
                        <!-- Input Entry Control and Border -->
                        <Border
                            x:Name="ModelNumberControl"
                            Margin="0,10,0,20"
                            HorizontalOptions="Start"
                            VerticalOptions="Start"
                            WidthRequest="200"
                            HeightRequest="40"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10,10,10,10">
                            <Entry
                                x:Name="ModelNumberEntry"
                                Text="{Binding ActivePrintTicket.VariableFields.ModelNumber}"
                                MaxLength="3"/>
                        </Border>
                    </HorizontalStackLayout>
                    <!-- Heat Number Input Layout -->
                    <HorizontalStackLayout
                        IsVisible="{Binding ActivePrintTicket.Process.RequiredFields.HeatNumber}">
                        <!-- Input Label -->
                        <Label
                            x:Name="HeatNumberLabel"
                            Margin="20,10,10,20"
                            HorizontalOptions="Start"
                            VerticalOptions="Center"
                            WidthRequest="80"
                            MinimumWidthRequest="80"
                            Text="Heat #"/>
                        <!-- Input Entry Control and Border -->
                        <Border
                            x:Name="HeatNumberControl"
                            Margin="0,10,0,20"
                            HorizontalOptions="Start"
                            VerticalOptions="Start"
                            WidthRequest="200"
                            HeightRequest="40"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10,10,10,10">
                            <Entry
                                x:Name="HeatNumberEntry"
                                Text="{Binding ActivePrintTicket.VariableFields.HeatNumber}"/>
                        </Border>
                    </HorizontalStackLayout>
                </HorizontalStackLayout>

                <!-- Separator Bar -->
                <BoxView
                    Grid.Row="6"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Margin="0"
                    HeightRequest="1"
                    HorizontalOptions="Fill"
                    VerticalOptions="Center"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Foreground}, Dark={StaticResource ForegroundDark}}"/>

                <!-- First Partial Data Set Layout -->
                <Grid
                    Grid.Row="7"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    IsVisible="{Binding ActivePrintTicket.HasFirstPartialDataSet}">
                    <Grid.RowDefinitions>
                        <!-- Header Row -->
                        <RowDefinition Height="Auto"/>
                        <!-- Inputs Row -->
                        <RowDefinition Height="Auto"/>
                        <!-- Buttons Row -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <!-- Shift Input Column -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Quantity Input Column -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Operator Input Column -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Margin Column -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- Header Label -->
                    <Label
                        Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Margin="20"
                        FontSize="16"
                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                        Text="Partial Production Data #1"/>
                    <!-- Shift Number Input Layout -->
                    <HorizontalStackLayout
                        Grid.Row="1"
                        Grid.Column="0">
                        <!-- Input Label -->
                        <Label
                            Margin="20,10,10,10"
                            x:Name="FirstPartialDataSetShiftLabel"
                            HorizontalOptions="Start"
                            VerticalOptions="Center"
                            WidthRequest="80"
                            MinimumWidthRequest="80"
                            Text="Shift"/>
                        <!-- Input Entry Control and Border -->
                        <Border
                            x:Name="FirstPartialDataSetShiftControl"
                            Margin="0,10,0,10"
                            HorizontalOptions="Start"
                            VerticalOptions="Start"
                            WidthRequest="200"
                            HeightRequest="40"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10,10,10,10">
                            <Picker
                                x:Name="FirstPartialDataSetShiftPicker"
                                SelectedItem="{Binding ActivePrintTicket.FirstPartialDataSet.Shift}">
                                <Picker.ItemsSource>
                                    <x:Array Type ="{x:Type x:Int32}">
                                        <x:Int32>1</x:Int32>
                                        <x:Int32>2</x:Int32>
                                        <x:Int32>3</x:Int32>
                                    </x:Array>
                                </Picker.ItemsSource>
                            </Picker>
                        </Border>
                    </HorizontalStackLayout>
                    <!-- Quantity Input Layout -->
                    <HorizontalStackLayout
                        Grid.Row="1"
                        Grid.Column="1">
                        <!-- Input Label -->
                        <Label
                            x:Name="FirstPartialDataSetQuantityLabel"
                            Margin="20,10,10,10"
                            HorizontalOptions="Start"
                            VerticalOptions="Center"
                            WidthRequest="80"
                            MinimumWidthRequest="80"
                            Text="Quantity"/>
                        <!-- Input Entry Control and Border -->
                        <Border
                            x:Name="FirstPartialDataSetQuantityControl"
                            Margin="0,10,0,10"
                            HorizontalOptions="Start"
                            VerticalOptions="Start"
                            WidthRequest="200"
                            HeightRequest="40"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10,10,10,10">
                            <Entry
                                x:Name="FirstPartialDataSetQuantityEntry"
                                Text="{Binding ActivePrintTicket.FirstPartialDataSet.Quantity}"/>
                        </Border>
                    </HorizontalStackLayout>
                    <!-- Operator Input Layout -->
                    <HorizontalStackLayout
                        Grid.Row="1"
                        Grid.Column="2">
                        <!-- Input Label -->
                        <Label
                            x:Name="FirstPartialDataSetOperatorLabel"
                            Margin="20,10,10,10"
                            HorizontalOptions="Start"
                            VerticalOptions="Center"
                            WidthRequest="80"
                            MinimumWidthRequest="80"
                            Text="Operator"/>
                        <!-- Input Entry Control and Border -->
                        <Border
                            x:Name="FirstPartialDataSetOperatorControl"
                            Margin="0,10,0,10"
                            HorizontalOptions="Start"
                            VerticalOptions="Start"
                            WidthRequest="200"
                            HeightRequest="40"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10,10,10,10">
                            <Entry
                                x:Name="FirstPartialDataSetOperatorEntry"
                                Text="{Binding ActivePrintTicket.FirstPartialDataSet.Operator}"
                                MaxLength="3"/>
                        </Border>
                    </HorizontalStackLayout>
                    <!-- Print Button -->
                    <Button
                        Grid.Row="3"
                        Grid.Column="0"
                        Text="Print Label"
                        Margin="20"
                        WidthRequest="100"
                        HeightRequest="40"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"/>
                    <!-- Remove Button -->
                    <Button
                        Grid.Row="3"
                        Grid.Column="3"
                        x:Name="RemoveFirstPartialProductionDataSetButton"
                        Clicked="OnRemoveFirstPartialProductionDataSetButtonClicked"
                        Text="- Remove"
                        Margin="20"
                        WidthRequest="100"
                        HeightRequest="40"
                        HorizontalOptions="End"
                        VerticalOptions="Center"/>
                </Grid>
                
                <!-- Separator Bar -->
                <BoxView
                    Grid.Row="8"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Margin="0"
                    HeightRequest="1"
                    HorizontalOptions="Fill"
                    VerticalOptions="Center"
                    IsVisible="{Binding ActivePrintTicket.HasFirstPartialDataSet}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Foreground}, Dark={StaticResource ForegroundDark}}"/>
                    
                <!-- Second Partial Dataset Layout -->
                <Grid
                    Grid.Row="9"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    IsVisible="{Binding ActivePrintTicket.HasSecondPartialDataSet}">
                    <Grid.RowDefinitions>
                        <!-- Header Row -->
                        <RowDefinition Height="Auto"/>
                        <!-- Inputs Row -->
                        <RowDefinition Height="Auto"/>
                        <!-- Buttons Row -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <!-- Shift Input Column -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Quantity Input Column -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Operator Input Column -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Margin Column -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- Header Label -->
                    <Label
                        Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Margin="20"
                        FontSize="16"
                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                        Text="Partial Production Data #2"/>
                    <!-- Shift Number Input Layout -->
                    <HorizontalStackLayout
                        Grid.Row="1"
                        Grid.Column="0">
                        <!-- Input Label -->
                        <Label
                            Margin="20,10,10,10"
                            x:Name="SecondPartialDataSetShiftLabel"
                            HorizontalOptions="Start"
                            VerticalOptions="Center"
                            WidthRequest="80"
                            MinimumWidthRequest="80"
                            Text="Shift"/>
                        <!-- Input Entry Control and Border -->
                        <Border
                            x:Name="SecondPartialDataSetShiftControl"
                            Margin="0,10,0,10"
                            HorizontalOptions="Start"
                            VerticalOptions="Start"
                            WidthRequest="200"
                            HeightRequest="40"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10,10,10,10">
                            <Picker
                                x:Name="SecondPartialDataSetShiftPicker"
                                SelectedItem="{Binding ActivePrintTicket.SecondPartialDataSet.Shift}">
                                <Picker.ItemsSource>
                                    <x:Array Type ="{x:Type x:Int32}">
                                        <x:Int32>1</x:Int32>
                                        <x:Int32>2</x:Int32>
                                        <x:Int32>3</x:Int32>
                                    </x:Array>
                                </Picker.ItemsSource>
                            </Picker>
                        </Border>
                    </HorizontalStackLayout>
                    <!-- Quantity Input Layout -->
                    <HorizontalStackLayout
                        Grid.Row="1"
                        Grid.Column="1">
                        <!-- Input Label -->
                        <Label
                            x:Name="SecondPartialDataSetQuantityLabel"
                            Margin="20,10,10,10"
                            HorizontalOptions="Start"
                            VerticalOptions="Center"
                            WidthRequest="80"
                            MinimumWidthRequest="80"
                            Text="Quantity"/>
                        <!-- Input Entry Control and Border -->
                        <Border
                            x:Name="SecondPartialDataSetQuantityControl"
                            Margin="0,10,0,10"
                            HorizontalOptions="Start"
                            VerticalOptions="Start"
                            WidthRequest="200"
                            HeightRequest="40"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10,10,10,10">
                            <Entry
                                x:Name="SecondPartialDataSetQuantityEntry"
                                Text="{Binding ActivePrintTicket.SecondPartialDataSet.Quantity}"/>
                        </Border>
                    </HorizontalStackLayout>
                    <!-- Operator Input Layout -->
                    <HorizontalStackLayout
                        Grid.Row="1"
                        Grid.Column="2">
                        <!-- Input Label -->
                        <Label
                            x:Name="SecondPartialDataSetOperatorLabel"
                            Margin="20,10,10,10"
                            HorizontalOptions="Start"
                            VerticalOptions="Center"
                            WidthRequest="80"
                            MinimumWidthRequest="80"
                            Text="Operator"/>
                        <!-- Input Entry Control and Border -->
                        <Border
                            x:Name="SecondPartialDataSetOperatorControl"
                            Margin="0,10,0,10"
                            HorizontalOptions="Start"
                            VerticalOptions="Start"
                            WidthRequest="200"
                            HeightRequest="40"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10,10,10,10">
                            <Entry
                                x:Name="SecondPartialDataSetOperatorEntry"
                                Text="{Binding ActivePrintTicket.SecondPartialDataSet.Operator}"
                                MaxLength="3"/>
                        </Border>
                    </HorizontalStackLayout>
                    <!-- Print Button -->
                    <Button
                        Grid.Row="3"
                        Grid.Column="0"
                        Text="Print Label"
                        Margin="20"
                        WidthRequest="100"
                        HeightRequest="40"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"/>
                    <!-- Remove Button -->
                    <Button
                        Grid.Row="3"
                        Grid.Column="3"
                        x:Name="RemoveSecondPartialProductionDataSetButton"
                        Clicked="OnRemoveSecondPartialProductionDataSetButtonClicked"
                        Text="- Remove"
                        Margin="20"
                        WidthRequest="100"
                        HeightRequest="40"
                        HorizontalOptions="End"
                        VerticalOptions="Center"/>
                </Grid>
                    
                <!-- Footer Row Fill -->
                <HorizontalStackLayout
                    Grid.Row="10"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill"
                    IsVisible="{Binding ActivePrintTicket.HasSpace}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Framing}, Dark={StaticResource FramingDark}}">
                    <!-- Add Partial Production Dataset Button -->
                    <Button
                        x:Name="AddPartialProductionDatasetButton"
                        Clicked="OnAddPartialProductionDataSetButtonClicked"
                        Margin="20"
                        WidthRequest="125"
                        HeightRequest="40"
                        HorizontalOptions="Start"
                        VerticalOptions="Start"
                        Text="+ Add Partial"/>
                </HorizontalStackLayout>
            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>

