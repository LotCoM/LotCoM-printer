<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:Datasources="clr-namespace:LotCoMPrinter.Models.Datasources"
             xmlns:ViewModels="clr-namespace:LotCoMPrinter.ViewModels"
             x:DataType="ViewModels:MainPageViewModel"
             x:Class="LotCoMPrinter.Views.MainPage">

    <!-- Main Layout Grid -->
    <Grid>
        <Grid.RowDefinitions>
            <!-- Main Row -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <!-- Active Print Ticket Column -->
            <ColumnDefinition Width="*"/>
            <!-- Open Print Tickets Panel Column -->
            <ColumnDefinition Width="{Binding Options.OpenPrintTicketsPanelWidth}"/>
        </Grid.ColumnDefinitions>
        <!-- Active Print Ticket Layout Grid -->
        <Grid
            Grid.Row="0"
            Grid.Column="0"
            IsVisible="True"> <!-- {Binding Options.HasActivePrintTicket} -->
            <Grid.RowDefinitions>
                <!-- Basic Label Information Input Row -->
                <RowDefinition Height="Auto"/>
                <!-- Separator Row -->
                <RowDefinition Height="10"/>
                <!-- First Partial Production Dataset Input Row -->
                <RowDefinition Height="Auto"/>
                <!-- Separator Row -->
                <RowDefinition Height="10"/>
                <!-- Second Partial Production Dataset Input Row -->
                <RowDefinition Height="Auto"/>
                <!-- Separator Row -->
                <RowDefinition Height="10"/>
                <!-- Add Partial Production Dataset Button Row -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <!-- Main Layout Column -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Basic Label Information Layout Grid -->
            <Grid
                Grid.Row="0"
                Grid.Column="0">
                <Grid.RowDefinitions>
                    <!-- Header Row -->
                    <RowDefinition Height="Auto"/>
                    <!-- Process / Production Date Input Row -->
                    <RowDefinition Height="Auto"/>
                    <!-- Part / Serial # Input Row -->
                    <RowDefinition Height="Auto"/>
                    <!-- Quantity Input Row -->
                    <RowDefinition Height="Auto"/>
                    <!-- Deburr JBK / Die / Model / Heat Input Row (Variable Fields) -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <!-- Process / Part / Quantity / Variable Fields Input Column -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Production Date / Serial # / Variable Fields Input Column -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Variable Fields Input Column -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Header Label -->
                <Label 
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="10,5,5,15"
                    HorizontalOptions="Start"
                    VerticalOptions="Center"
                    FontAttributes="Bold"
                    FontSize="20"
                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                    Text="{Binding ActivePrintTicket.Title, StringFormat='Input for Label: {0}'}"/>

                <!-- Process Input Horizontal Layout-->
                <HorizontalStackLayout
                    Grid.Row="1"
                    Grid.Column="0">
                    <!-- Input Label -->
                    <Label
                        x:Name="ProcessLabel"
                        Margin="10,0,0,0"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        WidthRequest="75"
                        MinimumWidthRequest="75"
                        Text="Process"/>
                    <!-- Input Picker Control and Border -->
                    <Border
                        x:Name="ProcessControl"
                        Margin="10,5,5,2"
                        HorizontalOptions="Start"
                        VerticalOptions="Start"
                        WidthRequest="250"
                        HeightRequest="40"
                        Stroke="#88ACACAC"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10,10,10,10"
                        Background="#00000000">
                        <Picker
                            x:Name="ProcessPicker"
                            ItemsSource="{Binding Source={RelativeSource AncestorType={x:Type ViewModels:MainPageViewModel}}, Path=AllProcesses}"
                            ItemDisplayBinding="{Binding FullName}"
                            SelectedIndex="{Binding Options.SelectedProcessIndex}"
                            SelectedIndexChanged="OnProcessSelection">
                        </Picker>
                    </Border>
                    <!-- Originator/Pass-through Indicator Card -->
                    <Border
                        x:Name="ProcessTypeCard"
                        Margin="5"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        HeightRequest="25"
                        WidthRequest="85"
                        Stroke="#00ACACAC"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 10,10,10,10"
                        Background="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                        <Label
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            x:Name="ProcessTypeLabel"
                            Text="{Binding Options.SelectedProcess.Type}"
                            TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}"
                            FontSize="11"/>
                    </Border>
                </HorizontalStackLayout>

                <!-- Production Date Input Horizontal Layout -->
                <HorizontalStackLayout
                    Grid.Row="1"
                    Grid.Column="1"
                    Grid.ColumnSpan="2">
                    <!-- Input Label -->
                    <Label
                        x:Name="ProductionDateLabel"
                        Margin="10,0,0,0"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        WidthRequest="75"
                        MinimumWidthRequest="75"
                        Text="Production Date"/>
                    <!-- Input DatePicker Control and Border -->
                    <Border
                        x:Name="ProductionDateControl"
                        Margin="10,5,5,2"
                        HorizontalOptions="Start"
                        VerticalOptions="Start"
                        WidthRequest="250"
                        HeightRequest="40"
                        Stroke="#88ACACAC"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10,10,10,10"
                        Background="#00000000"
                        >
                        <DatePicker
                            x:Name="ProductionDatePicker"/>
                    </Border>
                </HorizontalStackLayout>

                <!-- Part Input Horizontal Layout -->
                <HorizontalStackLayout
                    Grid.Row="2"
                    Grid.Column="0">
                    <!-- Input Label -->
                    <Label
                        x:Name="PartLabel"
                        Margin="10,0,0,0"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        WidthRequest="75"
                        MinimumWidthRequest="75"
                        Text="Part"/>
                    <!-- Input Picker Control and Border -->
                    <Border
                        x:Name="PartControl"
                        Margin="10,5,5,2"
                        HorizontalOptions="Start"
                        VerticalOptions="Start"
                        WidthRequest="250"
                        HeightRequest="40"
                        Grid.Row="1"
                        Grid.Column="1"
                        Stroke="#88ACACAC"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10,10,10,10"
                        Background="#00000000">
                        <Picker
                            x:Name="PartPicker"
                            ItemsSource="{Binding Options.SelectedProcessParts}"
                            ItemDisplayBinding="{Binding GetInfo}"
                            SelectedIndex="{Binding Options.SelectedPartIndex}"
                            SelectedIndexChanged="OnPartSelection"/>
                    </Border>
                </HorizontalStackLayout>

                <!-- Serial Number Input Horizontal Layout -->
                <HorizontalStackLayout
                    Grid.Row="2"
                    Grid.Column="1">
                    <!-- JBK Input Label -->
                    <Label
                        x:Name="JBKNumberLabel"
                        IsVisible="True"
                        Margin="10,0,0,0"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        WidthRequest="75"
                        MinimumWidthRequest="75"
                        Text="JBK #"/> <!-- IsVisible={Binding ActivePrintTicket.IsJBKSerialized} -->
                    <!-- JBK Input Entry Control and Border -->
                    <Border
                        x:Name="JBKNumberControl"
                        IsVisible="True"
                        Margin="10,5,5,2"
                        HorizontalOptions="Start"
                        VerticalOptions="Start"
                        WidthRequest="250"
                        HeightRequest="40"
                        Stroke="#88ACACAC"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10,10,10,10"
                        Background="#00000000"> <!-- IsVisible={Binding ActivePrintTicket.IsJBKSerialized} -->
                        <Entry
                            x:Name="JBKNumberEntry"
                            IsEnabled="{Binding ActivePrintTicket.IsJBKSerialized}"
                            Text="{Binding Options.DisplayedVariableFields.JBKNumber}"
                            MaxLength="3"/>
                    </Border>
                    <!-- Lot Input Label -->
                    <Label
                        x:Name="LotNumberLabel"
                        IsVisible="False"
                        Margin="10,0,0,0"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        WidthRequest="75"
                        MinimumWidthRequest="75"
                        Text="Lot #"/> <!-- IsVisible={Binding ActivePrintTicket.IsLotSerialized} -->
                    <!-- Lot Input Entry Control and Border -->
                    <Border
                        x:Name="LotNumberControl"
                        IsVisible="False"
                        Margin="10,5,5,2"
                        HorizontalOptions="Start"
                        VerticalOptions="Start"
                        WidthRequest="250"
                        HeightRequest="40"
                        Stroke="#88ACACAC"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10,10,10,10"
                        Background="#00000000"> <!-- IsVisible={Binding ActivePrintTicket.IsLotSerialized} -->
                        <Entry
                            x:Name="LotNumberEntry"
                            IsEnabled="{Binding ActivePrintTicket.IsLotSerialized}"
                            Text="{Binding Options.DisplayedVariableFields.LotNumber}"
                            MaxLength="9"/>
                    </Border>
                </HorizontalStackLayout>

                <!-- Quantity / Shift / Operator Input Horizontal Layout -->
                <HorizontalStackLayout
                    Grid.Row="3"
                    Grid.Column="0"
                    Grid.ColumnSpan="3">
                    <!-- Quantity Input Label -->
                    <Label
                        x:Name="QuantityLabel"
                        Margin="10,0,0,0"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        WidthRequest="75"
                        MinimumWidthRequest="75"
                        Text="Total Quantity"/>
                    <!-- Quantity Input Entry Control and Border -->
                    <Border
                        x:Name="QuantityControl"
                        Margin="10,5,5,2"
                        HorizontalOptions="Start"
                        VerticalOptions="Start"
                        WidthRequest="150"
                        HeightRequest="40"
                        Stroke="#88ACACAC"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10,10,10,10"
                        Background="#00000000">
                        <Entry
                            x:Name="QuantityEntry"/>
                    </Border>

                    <!-- Shift Input Label -->
                    <Label
                        x:Name="ShiftLabel"
                        Margin="10,0,0,0"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        WidthRequest="75"
                        MinimumWidthRequest="75"
                        Text="Shift"/>
                    <!-- Shift Input Picker Control and Border -->
                    <Border
                        x:Name="ShiftControl"
                        Margin="10,5,5,2"
                        HorizontalOptions="Start"
                        VerticalOptions="Start"
                        WidthRequest="100"
                        HeightRequest="40"
                        Stroke="#88ACACAC"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10,10,10,10"
                        Background="#00000000">
                        <Picker
                            x:Name="ShiftPicker"
                            SelectedItem="-1">
                            <Picker.ItemsSource>
                                <x:Array Type ="{x:Type x:Int32}">
                                    <x:Int32>1</x:Int32>
                                    <x:Int32>2</x:Int32>
                                    <x:Int32>3</x:Int32>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>
                    </Border>
                    <!-- Operator Input Label -->
                    <Label
                        x:Name="OperatorLabel"
                        Margin="10,0,0,0"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        WidthRequest="75"
                        MinimumWidthRequest="75"
                        Text="Operator"/>
                    <!-- Operator Input Entry Control and Border -->
                    <Border
                        x:Name="OperatorControl"
                        Margin="10,5,5,2"
                        HorizontalOptions="Start"
                        VerticalOptions="Start"
                        WidthRequest="100"
                        HeightRequest="40"
                        Stroke="#88ACACAC"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10,10,10,10"
                        Background="#00000000">
                        <Entry
                            x:Name="OperatorEntry"
                            Text=""
                            MaxLength="3"/>
                    </Border>
                </HorizontalStackLayout>

                <!-- Variable Fields Input Horizontal Layout -->
                <HorizontalStackLayout
                    Grid.Row="4"
                    Grid.Column="0"
                    Grid.ColumnSpan="3">

                    <!-- Deburr JBK Input Layout -->
                    <HorizontalStackLayout
                        IsVisible="False">
                        <!-- Input Label -->
                        <Label
                            x:Name="DeburrJBKNumberLabel"
                            Margin="10,0,0,0"
                            HorizontalOptions="Start"
                            VerticalOptions="Center"
                            WidthRequest="75"
                            MinimumWidthRequest="75"
                            Text="Deburr   JBK #"/>
                        <!-- Input Entry Control and Border -->
                        <Border
                            x:Name="DeburrJBKNumberControl"
                            Margin="10,5,5,2"
                            HorizontalOptions="Start"
                            VerticalOptions="Start"
                            WidthRequest="150"
                            HeightRequest="40"
                            Stroke="#88ACACAC"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10,10,10,10"
                            Background="#00000000">
                            <Entry
                                x:Name="DeburrJBKNumberEntry"
                                Text="{Binding Options.DisplayedVariableFields.DeburrJBKNumber}"
                                MaxLength="3"/>
                        </Border>
                    </HorizontalStackLayout>
                    
                    <!-- Die Number Input Layout -->
                    <HorizontalStackLayout
                        IsVisible="False">
                        <!-- Input Label -->
                        <Label
                            x:Name="DieNumberLabel"
                            Margin="10,0,0,0"
                            HorizontalOptions="Start"
                            VerticalOptions="Center"
                            WidthRequest="75"
                            MinimumWidthRequest="75"
                            Text="Die #"/>
                        <!-- Input Entry Control and Border -->
                        <Border
                            x:Name="DieNumberControl"
                            Margin="10,5,5,2"
                            HorizontalOptions="Start"
                            VerticalOptions="Start"
                            WidthRequest="150"
                            HeightRequest="40"
                            Stroke="#88ACACAC"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10,10,10,10"
                            Background="#00000000">
                            <Entry
                                x:Name="DieNumberEntry"
                                Text="{Binding Options.DisplayedVariableFields.DieNumber}"
                                MaxLength="3"/>
                        </Border>
                    </HorizontalStackLayout>
                    
                    <!-- Model Input Layout -->
                    <HorizontalStackLayout
                        IsVisible="False">
                        <!-- Input Label -->
                        <Label
                            x:Name="ModelNumberLabel"
                            Margin="10,0,0,0"
                            HorizontalOptions="Start"
                            VerticalOptions="Center"
                            WidthRequest="75"
                            MinimumWidthRequest="75"
                            Text="Model #"/>
                        <!-- Input Entry Control and Border -->
                        <Border
                            x:Name="ModelNumberControl"
                            Margin="10,5,5,2"
                            HorizontalOptions="Start"
                            VerticalOptions="Start"
                            WidthRequest="150"
                            HeightRequest="40"
                            Stroke="#88ACACAC"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10,10,10,10"
                            Background="#00000000">
                            <Entry
                                x:Name="ModelNumberEntry"
                                Text="{Binding Options.DisplayedVariableFields.ModelNumber}"
                                MaxLength="3"/>
                        </Border>
                    </HorizontalStackLayout>
                    
                    <!-- Heat Number Input Layout -->
                    <HorizontalStackLayout
                        IsVisible="False">
                        <!-- Input Label -->
                        <Label
                            x:Name="HeatNumberLabel"
                            Margin="10,0,0,0"
                            HorizontalOptions="Start"
                            VerticalOptions="Center"
                            WidthRequest="75"
                            MinimumWidthRequest="75"
                            Text="Heat #"/>
                        <!-- Input Entry Control and Border -->
                        <Border
                            x:Name="HeatNumberControl"
                            Margin="10,5,5,2"
                            HorizontalOptions="Start"
                            VerticalOptions="Start"
                            WidthRequest="150"
                            HeightRequest="40"
                            Stroke="#88ACACAC"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10,10,10,10"
                            Background="#00000000">
                            <Entry
                                x:Name="HeatNumberEntry"
                                Text="{Binding Options.DisplayedVariableFields.HeatNumber}"/>
                        </Border>
                    </HorizontalStackLayout>
                </HorizontalStackLayout>
            </Grid>

            <!-- Separator Bar -->
            <BoxView
                Grid.Row="1"
                Grid.Column="0"
                HeightRequest="1"
                HorizontalOptions="Fill"
                VerticalOptions="Center"
                BackgroundColor="#88ACACAC"/>

            <!-- First Partial Production Dataset Grid Layout -->
            <Grid
                Grid.Row="2"
                Grid.Column="0"
                IsVisible="{Binding ActivePrintTicket.HasFirstPartialDataSet}">
                <Grid.RowDefinitions>
                    <!-- Header Row -->
                    <RowDefinition Height="Auto"/>
                    <!-- Inputs Row -->
                    <RowDefinition Height="Auto"/>
                    <!-- Print Button / Remove Button Row -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <!-- Shift Input Column -->
                    <ColumnDefinition Width="*"/>
                    <!-- Quantity Input Column -->
                    <ColumnDefinition Width="*"/>
                    <!-- Operator Input Column -->
                    <ColumnDefinition Width="*"/>
                    <!-- Remove Button Column -->
                    <ColumnDefinition Width="30"/>
                </Grid.ColumnDefinitions>
                <!-- Header Label -->
                <Label
                    Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Text="Partial Production Data #1"/>
                <!-- Shift Number Input Layout -->
                <HorizontalStackLayout
                    Grid.Row="1"
                    Grid.Column="0">
                    <!-- Input Label -->
                    <Label
                        x:Name="FirstPartialDataSetShiftLabel"
                        Margin="10,0,0,0"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        WidthRequest="75"
                        MinimumWidthRequest="75"
                        Text="Shift"/>
                    <!-- Input Entry Control and Border -->
                    <Border
                        x:Name="FirstPartialDataSetShiftControl"
                        Margin="10,5,5,2"
                        HorizontalOptions="Start"
                        VerticalOptions="Start"
                        WidthRequest="100"
                        HeightRequest="40"
                        Stroke="#88ACACAC"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10,10,10,10"
                        Background="#00000000">
                        <Picker
                            x:Name="FirstPartialDataSetShiftPicker"
                            SelectedItem="{Binding ActivePrintTicket.FirstPartialDataSet.Shift}">
                            <Picker.ItemsSource>
                                <x:Array Type ="{x:Type x:Int32}">
                                    <x:Int32>1</x:Int32>
                                    <x:Int32>2</x:Int32>
                                    <x:Int32>3</x:Int32>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>
                    </Border>
                </HorizontalStackLayout>
                <!-- Quantity Input Layout -->
                <HorizontalStackLayout
                    Grid.Row="1"
                    Grid.Column="1">
                    <!-- Input Label -->
                    <Label
                        x:Name="FirstPartialDataSetQuantityLabel"
                        Margin="10,0,0,0"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        WidthRequest="75"
                        MinimumWidthRequest="75"
                        Text="Quantity"/>
                    <!-- Input Entry Control and Border -->
                    <Border
                        x:Name="FirstPartialDataSetQuantityControl"
                        Margin="10,5,5,2"
                        HorizontalOptions="Start"
                        VerticalOptions="Start"
                        WidthRequest="100"
                        HeightRequest="40"
                        Stroke="#88ACACAC"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10,10,10,10"
                        Background="#00000000">
                        <Entry
                            x:Name="FirstPartialDataSetQuantityEntry"
                            Text="{Binding ActivePrintTicket.FirstPartialDataSet.Quantity}"/>
                    </Border>
                </HorizontalStackLayout>
                <!-- Operator Input Layout -->
                <HorizontalStackLayout
                    Grid.Row="1"
                    Grid.Column="2">
                    <!-- Input Label -->
                    <Label
                        x:Name="FirstPartialDataSetOperatorLabel"
                        Margin="10,0,0,0"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        WidthRequest="75"
                        MinimumWidthRequest="75"
                        Text="Quantity"/>
                    <!-- Input Entry Control and Border -->
                    <Border
                        x:Name="FirstPartialDataSetOperatorControl"
                        Margin="10,5,5,2"
                        HorizontalOptions="Start"
                        VerticalOptions="Start"
                        WidthRequest="100"
                        HeightRequest="40"
                        Stroke="#88ACACAC"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10,10,10,10"
                        Background="#00000000">
                        <Entry
                            x:Name="FirstPartialDataSetOperatorEntry"
                            Text="{Binding ActivePrintTicket.FirstPartialDataSet.Operator}"
                            MaxLength="3"/>
                    </Border>
                </HorizontalStackLayout>
                <!-- Print Button -->
                <Button
                    Grid.Row="2"
                    Grid.Column="0"
                    Text="Print Label"
                    Margin="10,0,0,0"
                    WidthRequest="150"
                    HeightRequest="40"
                    HorizontalOptions="Start"
                    VerticalOptions="Center"/>
                <!-- Remove Button -->
                <Button
                    x:Name="RemoveFirstPartialProductionDataSetButton"
                    Grid.Row="2"
                    Grid.Column="3"
                    Clicked="OnRemoveFirstPartialProductionDataSetButtonClicked"
                    Text="-"
                    Margin="0"
                    Padding="0"
                    CharacterSpacing="0"
                    WidthRequest="25"
                    HeightRequest="25"
                    HorizontalOptions="Start"
                    VerticalOptions="Center"/>
            </Grid>

            <!-- Separator Bar -->
            <BoxView
                Grid.Row="3"
                Grid.Column="0"
                IsVisible="{Binding ActivePrintTicket.HasFirstPartialDataSet}"
                HeightRequest="1"
                HorizontalOptions="Fill"
                VerticalOptions="Center"
                BackgroundColor="#88ACACAC"/>

            <!-- Second Partial Production Dataset Grid Layout -->
            <Grid
                Grid.Row="4"
                Grid.Column="0"
                IsVisible="{Binding ActivePrintTicket.HasSecondPartialDataSet}">
                <Grid.RowDefinitions>
                    <!-- Header Row -->
                    <RowDefinition Height="Auto"/>
                    <!-- Inputs Row -->
                    <RowDefinition Height="Auto"/>
                    <!-- Print Button / Remove Button Row -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <!-- Shift Input Column -->
                    <ColumnDefinition Width="*"/>
                    <!-- Quantity Input Column -->
                    <ColumnDefinition Width="*"/>
                    <!-- Operator Input Column -->
                    <ColumnDefinition Width="*"/>
                    <!-- Remove Button Column -->
                    <ColumnDefinition Width="30"/>
                </Grid.ColumnDefinitions>
                <!-- Header Label -->
                <Label
                    Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Text="Partial Production Data #2"/>
                <!-- Shift Number Input Layout -->
                <HorizontalStackLayout
                    Grid.Row="1"
                    Grid.Column="0">
                    <!-- Input Label -->
                    <Label
                        x:Name="SecondPartialDataSetShiftLabel"
                        Margin="10,0,0,0"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        WidthRequest="75"
                        MinimumWidthRequest="75"
                        Text="Shift"/>
                    <!-- Input Entry Control and Border -->
                    <Border
                        x:Name="SecondPartialDataSetShiftControl"
                        Margin="10,5,5,2"
                        HorizontalOptions="Start"
                        VerticalOptions="Start"
                        WidthRequest="100"
                        HeightRequest="40"
                        Stroke="#88ACACAC"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10,10,10,10"
                        Background="#00000000">
                        <Picker
                            x:Name="SecondPartialDataSetShiftPicker"
                            SelectedItem="{Binding ActivePrintTicket.SecondPartialDataSet.Shift}">
                            <Picker.ItemsSource>
                                <x:Array Type ="{x:Type x:Int32}">
                                    <x:Int32>1</x:Int32>
                                    <x:Int32>2</x:Int32>
                                    <x:Int32>3</x:Int32>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>
                    </Border>
                </HorizontalStackLayout>
                <!-- Quantity Input Layout -->
                <HorizontalStackLayout
                    Grid.Row="1"
                    Grid.Column="1">
                    <!-- Input Label -->
                    <Label
                        x:Name="SecondPartialDataSetQuantityLabel"
                        Margin="10,0,0,0"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        WidthRequest="75"
                        MinimumWidthRequest="75"
                        Text="Quantity"/>
                    <!-- Input Entry Control and Border -->
                    <Border
                        x:Name="SecondPartialDataSetQuantityControl"
                        Margin="10,5,5,2"
                        HorizontalOptions="Start"
                        VerticalOptions="Start"
                        WidthRequest="100"
                        HeightRequest="40"
                        Stroke="#88ACACAC"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10,10,10,10"
                        Background="#00000000">
                        <Entry
                            x:Name="SecondPartialDataSetQuantityEntry"
                            Text="{Binding ActivePrintTicket.SecondPartialDataSet.Quantity}"/>
                    </Border>
                </HorizontalStackLayout>
                <!-- Operator Input Layout -->
                <HorizontalStackLayout
                    Grid.Row="1"
                    Grid.Column="2">
                    <!-- Input Label -->
                    <Label
                        x:Name="SecondPartialDataSetOperatorLabel"
                        Margin="10,0,0,0"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        WidthRequest="75"
                        MinimumWidthRequest="75"
                        Text="Quantity"/>
                    <!-- Input Entry Control and Border -->
                    <Border
                        x:Name="SecondPartialDataSetOperatorControl"
                        Margin="10,5,5,2"
                        HorizontalOptions="Start"
                        VerticalOptions="Start"
                        WidthRequest="100"
                        HeightRequest="40"
                        Stroke="#88ACACAC"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10,10,10,10"
                        Background="#00000000">
                        <Entry
                            x:Name="SecondPartialDataSetOperatorEntry"
                            Text="{Binding ActivePrintTicket.SecondPartialDataSet.Operator}"
                            MaxLength="3"/>
                    </Border>
                </HorizontalStackLayout>
                <!-- Print Button -->
                <Button
                    Grid.Row="2"
                    Grid.Column="0"
                    Text="Print Label"
                    Margin="10,0,0,0"
                    WidthRequest="150"
                    HeightRequest="40"
                    HorizontalOptions="Start"
                    VerticalOptions="Center"/>
                <!-- Remove Button -->
                <Button
                    x:Name="RemoveSecondPartialProductionDataSetButton"
                    Grid.Row="2"
                    Grid.Column="3"
                    Clicked="OnRemoveSecondPartialProductionDataSetButtonClicked"
                    Text="-"
                    Margin="0"
                    Padding="0"
                    CharacterSpacing="0"
                    WidthRequest="25"
                    HeightRequest="25"
                    HorizontalOptions="Start"
                    VerticalOptions="Center"/>
            </Grid>

            <!-- Add Partial Production Dataset Button -->
            <Button
                x:Name="AddPartialProductionDatasetButton"
                Grid.Row="7"
                Grid.Column="0"
                Clicked="OnAddPartialProductionDataSetButtonClicked"
                IsVisible="{Binding ActivePrintTicket.HasSpace}"
                Margin="10,0,0,0"
                Padding="0"
                WidthRequest="100"
                HeightRequest="40"
                HorizontalOptions="Start"
                VerticalOptions="Center"
                Text="+ Add Partial"/>
        </Grid>

        <!-- Open Print Tickets Panel Grid -->
        <Grid
            Grid.Row="0"
            Grid.Column="1"
            IsVisible="{Binding Options.IsOpenPrintTicketsPanelShown}"
            WidthRequest="{Binding Options.OpenPrintTicketsPanelWidth}">
            <Grid.RowDefinitions>
                <!-- Header Row -->
                <RowDefinition Height="100"/>
                <!-- Body (ListView) Row -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <!-- Single Column for the Panel -->
                <ColumnDefinition Width="{Binding Options.OpenPrintTicketsPanelWidth}"/>
            </Grid.ColumnDefinitions>
            <Label
                x:Name="OpenPrintTicketsHeaderLabel"
                Grid.Row="0"
                Grid.Column="0"
                Text="Open Labels"
                HorizontalOptions="Center"
                VerticalOptions="Start"/>
            <ListView
                x:Name="OpenPrintTicketsListView"
                Grid.Row="1"
                Grid.Column="0">
            </ListView>
            <BoxView
                x:Name="OpenPrintTicketsLeftBorder"
                Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="0"
                WidthRequest="1"
                VerticalOptions="Fill"
                HorizontalOptions="Start"/>
        </Grid>

    </Grid>
</ContentPage>

