                        </HorizontalStackLayout>
                        <!-- Print Button -->
                        <Button
                            Grid.Row="3"
                            Grid.Column="0"
                            Text="Print Label"
                            Margin="20"
                            WidthRequest="100"
                            HeightRequest="40"
                            HorizontalOptions="Start"
                            VerticalOptions="Center"/>
                        <!-- Remove Button -->
                        <Button
                            Grid.Row="3"
                            Grid.Column="3"
                            x:Name="RemoveSecondPartialProductionDataSetButton"
                            Clicked="OnRemoveSecondPartialProductionDataSetButtonClicked"
                            Text="- Remove"
                            Margin="20"
                            WidthRequest="100"
                            HeightRequest="40"
