                                VerticalOptions="Start"
                                WidthRequest="200"
                                HeightRequest="40"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10,10,10,10">
                                <Entry
                                    x:Name="FirstPartialDataSetQuantityEntry"
                                    Text="{Binding ActiveTicket.Tracked.FirstPartialDataSet.Quantity}"/>
                            </Border>
                        </HorizontalStackLayout>
                        <!-- Operator Input Layout -->
                        <HorizontalStackLayout
                            Grid.Row="1"
                            Grid.Column="2">
                            <!-- Input Label -->
                            <Label
                                x:Name="FirstPartialDataSetOperatorLabel"
