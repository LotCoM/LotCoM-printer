<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:Datatypes="clr-namespace:LotCoMPrinter.Models.Datatypes"
             xmlns:Enums="clr-namespace:LotCom.Enums;assembly=LotCom"
             xmlns:ViewModels="clr-namespace:LotCoMPrinter.ViewModels"
             x:DataType="ViewModels:MainPageViewModel"
             x:Class="LotCoMPrinter.Views.MainPage">

    <!-- Customize NavigationPage Bar and Properties -->
    <NavigationPage.HasBackButton>
        <x:Boolean>False</x:Boolean>
    </NavigationPage.HasBackButton>
    <NavigationPage.HasNavigationBar>
        <x:Boolean>False</x:Boolean>
    </NavigationPage.HasNavigationBar>

    <!-- Merge and Consume Custom ResourceDictionaries -->
    <ContentPage.Resources>
        <!-- SecondaryButton Styles -->
        <ResourceDictionary Source="/Resources/Styles/SecondaryButton.xaml"/>
        <!-- RecessedButton Styles -->
        <ResourceDictionary Source="/Resources/Styles/RecessedButton.xaml"/>
        <!-- GreenButton Styles -->
        <ResourceDictionary Source="/Resources/Styles/GreenButton.xaml"/>
        <!-- RedButton Styles -->
        <ResourceDictionary Source="/Resources/Styles/RedButton.xaml"/>
        <!-- InfoButton Styles -->
        <ResourceDictionary Source="/Resources/Styles/InfoButton.xaml"/>
        <!-- WarnButton Styles -->
        <ResourceDictionary Source="/Resources/Styles/WarnButton.xaml"/>
        <!-- TransparentImageButton Styles -->
        <ResourceDictionary Source="/Resources/Styles/TransparentImageButton.xaml"/>
    </ContentPage.Resources>

    <!-- Main Layout Grid (Welcome Menu, Ticket Editor, and Open Tickets) -->
    <Grid>
        <Grid.RowDefinitions>
            <!-- Main Layout Row -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <!-- Open Print Tickets Panel Column -->
            <ColumnDefinition Width="Auto"/>
            <!-- Welcome Menu / Ticket Editor Column -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Open Print Tickets Panel Layout -->
        <Grid
            Grid.Row="0"
            Grid.Column="0"
            BackgroundColor="{StaticResource Primary-80}"
            WidthRequest="{Binding OpenPrintTicketsPanelWidth}">
            <Grid.RowDefinitions>
                <!-- Header Row -->
                <RowDefinition Height="Auto"/>
                <!-- Body (ListView) Row -->
                <RowDefinition Height="*"/>
                <!-- Body Collapse/Raise Button Row -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <!-- Single Column for the Panel -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Panel Header Label -->
            <Label
                x:Name="OpenPrintTicketsHeaderLabel"
                IsVisible="{Binding IsOpenPrintTicketsPanelShown}"
                TextColor="{StaticResource TextLight}"
                FontSize="18"
                Grid.Row="0"
                Grid.Column="0"
                Margin="0,20,0,20"
                Text="In-Process Labels"
                HorizontalOptions="Center"
                VerticalOptions="Center"/>
            <!-- Panel Body List -->
            <CollectionView
                Grid.Row="1"
                Grid.Column="0"
                x:Name="OpenPrintTicketsCollectionView"
                IsVisible="{Binding IsOpenPrintTicketsPanelShown}"
                BackgroundColor="{StaticResource Primary-100}"
                SelectionMode="Single"
                ItemsSource="{Binding OpenPrintTickets}"
                SelectedItem="{Binding SelectedTicket}"
                SelectionChanged="OnOpenPrintTicketsCollectionViewSelectionChanged"
                Margin="10"
                HorizontalOptions="Start"
                VerticalOptions="Start">
                <CollectionView.ItemTemplate>
                    <DataTemplate
                        x:DataType="Datatypes:PrintTicket">
                        <!-- Configurable ListView Grid Layout -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <!-- Process & Date Row -->
                                <RowDefinition Height="Auto"/>
                                <!-- Title & Shift Row -->
                                <RowDefinition Height="Auto"/>
                                <!-- Open Button Row -->
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <!-- Process / Title Column -->
                                <ColumnDefinition Width="*"/>
                                <!-- Date / Shift Column -->
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Process Label -->
                            <Label 
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="5,5,0,0"
                                Text="{Binding Process.FullName}"
                                TextColor="{StaticResource Secondary-0}"
                                FontSize="16"
                                HorizontalOptions="Start"
                                VerticalOptions="Center"/>
                            <!-- Date Label -->
                            <Label 
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="0,5,5,0"
                                Text="{Binding ProductionDateShort}"
                                TextColor="{StaticResource Secondary-0}"
                                FontSize="16"
                                HorizontalOptions="End"
                                VerticalOptions="Center"/>
                            <!-- Title Label -->
                            <Label
                                Grid.Row="1"
                                Grid.Column="0"
                                Margin="5,5,0,0"
                                Text="{Binding Title}"
                                TextColor="{StaticResource TextLightDisabled}"
                                FontSize="12"
                                HorizontalOptions="Start"
                                VerticalOptions="Center"/>
                            <!-- Shift Label -->
                            <Label
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="0,5,5,0"
                                Text="{Binding ProductionShift}"
                                TextColor="{StaticResource TextLightDisabled}"
                                FontSize="12"
                                HorizontalOptions="End"
                                VerticalOptions="Center"/>
                            <!-- Open Ticket Button -->
                            <Button
                                x:Name="OpenPrintTicketFromCollectionViewButton"
                                IsVisible="{Binding IsSelectedInList}"
                                Clicked="OnOpenPrintTicketFromCollectionViewButtonClicked"
                                Grid.Row="2"
                                Grid.Column="1"
                                Margin="5"
                                Padding="0"
                                CharacterSpacing="0"
                                HorizontalOptions="End"
                                VerticalOptions="Center"
                                WidthRequest="50"
                                HeightRequest="25"
                                MinimumHeightRequest="25"
                                Text="Open >"
                                ToolTipProperties.Text="Edit this Label Ticket"
                                FontSize="10">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroupList>
                                        <VisualStateGroup x:Name="SecondaryStates">
                                            <VisualState x:Name="Normal">
                                                <VisualState.Setters>
                                                    <Setter Property="Style" Value="{StaticResource SecondaryNormalStyle}"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Disabled">
                                                <VisualState.Setters>
                                                    <Setter Property="Style" Value="{StaticResource SecondaryDisabledStyle}"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Pressed">
                                                <VisualState.Setters>
                                                    <Setter Property="Style" Value="{StaticResource SecondaryPressedStyle}"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="PointerOver">
                                                <VisualState.Setters>
                                                    <Setter Property="Style" Value="{StaticResource SecondaryPointerOverStyle}"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateGroupList>
                                </VisualStateManager.VisualStateGroups>
                            </Button>
                            <!-- Bottom Border -->
                            <BoxView
                                Grid.Row="2"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Margin="0,5,0,0"
                                HeightRequest="1"
                                HorizontalOptions="Fill"
                                VerticalOptions="End"
                                BackgroundColor="{StaticResource Neutral-20}"/>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <!-- Panel Collapse/Raise Button -->
            <ImageButton
                x:Name="OpenPrintTicketsCollapseButton"
                Grid.Row="0"
                Grid.Column="0"
                Clicked="OnOpenPrintTicketsCollapseButtonClicked"
                Margin="20"
                Padding="10"
                Rotation="180"
                VerticalOptions="End"
                HorizontalOptions="End"
                HeightRequest="30"
                WidthRequest="30"
                CornerRadius="30"
                Source="menu.png"
                ToolTipProperties.Text="Show/Hide the Open Print Tickets Menu">
                <ImageButton.Behaviors>
                    <toolkit:IconTintColorBehavior TintColor="{StaticResource Neutral-White}"/>
                </ImageButton.Behaviors>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="TransparentStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="Style" Value="{StaticResource TransparentNormalStyle}"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="Style" Value="{StaticResource TransparentDisabledStyle}"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Style" Value="{StaticResource TransparentPressedStyle}"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="Style" Value="{StaticResource TransparentPointerOverStyle}"/>
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>
            </ImageButton>
            <!-- Panel Left Border -->
            <BoxView
                x:Name="OpenPrintTicketsLeftBorder"
                Grid.Row="0"
                Grid.RowSpan="3"
                Grid.Column="0"
                WidthRequest="1"
                VerticalOptions="Fill"
                HorizontalOptions="End"
                BackgroundColor="{StaticResource Neutral-20}"/>
        </Grid>

        <!-- Welcome Menu Layout -->
        <Grid
            Grid.Row="0"
            Grid.Column="1"
            IsVisible="{Binding IsWelcomeMenuShown}"
            BackgroundColor="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource BackgroundDark}}">
            <Grid.RowDefinitions>
                <!-- Header Row -->
                <RowDefinition Height="150"/>
                <!-- Body Row -->
                <RowDefinition Height="*"/>
                <!-- Footer Row -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- Welcome Menu Header -->
            <VerticalStackLayout
                Grid.Row="0"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                BackgroundColor="{StaticResource Neutral-OffWhite}">
                <!-- Title Label -->
                <Label
                    Margin="20"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    FontSize="52"
                    FontAttributes="Bold"
                    TextColor="{StaticResource Primary-20}"
                    Text="{Binding WelcomeMenuTitleLabelText}"/>
            </VerticalStackLayout>
            <!-- Welcome Menu Body -->
            <Grid
                Grid.Row="1"
                BackgroundColor="{StaticResource Neutral-White}">
                <Grid.RowDefinitions>
                    <!-- Button Header Labels Row -->
                    <RowDefinition Height="Auto"/>
                    <!-- Button Row -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <!-- Start New Label Column -->
                    <ColumnDefinition Width="*"/>
                    <!-- Edit Existing Label Column -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- Start New Label Control -->
                <BoxView
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="10"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    CornerRadius="40"
                    WidthRequest="200"
                    HeightRequest="275"
                    BackgroundColor="{StaticResource Neutral-OffWhite}"/>
                <Label 
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="10"
                    HorizontalOptions="Center"
                    VerticalOptions="End"
                    FontSize="32"
                    FontAttributes="Bold"
                    TextColor="{StaticResource TextDark}"
                    Text="Start New Label"/>
                <ImageButton
                    Clicked="OnStartNewLabelButtonClicked"
                    Grid.Row="1"
                    Grid.Column="0"
                    Source="plus.png"
                    WidthRequest="150"
                    HeightRequest="150"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    CornerRadius="100"
                    ToolTipProperties.Text="Create and Edit a New Label">
                    <ImageButton.Behaviors>
                        <toolkit:IconTintColorBehavior TintColor="{StaticResource Primary-20}"/>
                    </ImageButton.Behaviors>
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroupList>
                            <VisualStateGroup x:Name="TransparentStates">
                                <VisualState x:Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Property="Style" Value="{StaticResource TransparentNormalStyle}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Property="Style" Value="{StaticResource TransparentDisabledStyle}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Property="Style" Value="{StaticResource TransparentPressedStyle}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Property="Style" Value="{StaticResource TransparentPointerOverStyle}"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateGroupList>
                    </VisualStateManager.VisualStateGroups>
                </ImageButton>
                <!-- Edit Existing Label Control -->
                <BoxView
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="10"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    CornerRadius="40"
                    WidthRequest="200"
                    HeightRequest="275"
                    BackgroundColor="{StaticResource Neutral-OffWhite}"/>
                <Label 
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="10"
                    HorizontalOptions="Center"
                    VerticalOptions="End"
                    FontSize="32"
                    FontAttributes="Bold"
                    TextColor="{StaticResource TextDark}"
                    Text="Edit Existing Label"/>
                <ImageButton
                    Grid.Row="1"
                    Grid.Column="1"
                    Source="edit.png"
                    WidthRequest="150"
                    HeightRequest="150"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    CornerRadius="100"
                    ToolTipProperties.Text="Modify an Existing Label">
                    <ImageButton.Behaviors>
                        <toolkit:IconTintColorBehavior TintColor="{StaticResource Primary-20}"/>
                    </ImageButton.Behaviors>
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroupList>
                            <VisualStateGroup x:Name="TransparentStates">
                                <VisualState x:Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Property="Style" Value="{StaticResource TransparentNormalStyle}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Property="Style" Value="{StaticResource TransparentDisabledStyle}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Property="Style" Value="{StaticResource TransparentPressedStyle}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Property="Style" Value="{StaticResource TransparentPointerOverStyle}"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateGroupList>
                    </VisualStateManager.VisualStateGroups>
                </ImageButton>
                <!-- Sub-Title Label -->
                <!-- <Label
                    Margin="20"
                    HorizontalOptions="Start"
                    VerticalOptions="Center"
                    FontSize="32"
                    TextColor="{StaticResource TextDark}"
                    Text="{Binding WelcomeMenuSubTitleLabelText}"/> -->
            </Grid>
            <!-- Welcome Menu Footer -->
            <HorizontalStackLayout
                Grid.Row="2"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                BackgroundColor="{StaticResource Neutral-OffWhite}">
                <!-- Start New Label Button -->
                <!-- <Button
                    x:Name="StartNewLabelButton"
                    Clicked="OnStartNewLabelButtonClicked"
                    IsVisible="{Binding IsWelcomeMenuShown}"
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="20"
                    HorizontalOptions="Start"
                    VerticalOptions="End"
                    Text="Start New Label"/> -->
            </HorizontalStackLayout>
        </Grid>

        <!-- Print Ticket Editor Layout -->
        <Grid
            x:Name="TicketEditorMenu"
            Grid.Row="0"
            Grid.Column="1"
            IsVisible="{Binding IsTicketEditorMenuShown}">
            <Grid.RowDefinitions>
                <!-- Header Panel Row -->
                <RowDefinition Height="Auto"/>
                <!-- Scrolling Body Panel Row -->
                <RowDefinition Height="*"/>
                <!-- Footer Panel Row -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header Panel -->
            <Grid
                Grid.Row="0"
                x:Name="TicketEditorMenuHeader"
                BackgroundColor="{StaticResource Neutral-OffWhite}">
                <Grid.RowDefinitions>
                    <!-- Editor Title Row -->
                    <RowDefinition Height="Auto"/>
                    <!-- Label Title Row -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <!-- Titles Column -->
                    <ColumnDefinition Width="*"/>
                    <!-- Action Buttons Column -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Header Row Label -->
                <Label
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="20,10,0,10"
                    HorizontalOptions="Start"
                    VerticalOptions="Center"
                    FontSize="32"
                    FontAttributes="Bold"
                    TextColor="{StaticResource Primary-20}"
                    Text="Label Editor"/>

                <!-- Ticket Name Label -->
                <Label
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="20,0,0,10"
                    HorizontalOptions="Start"
                    VerticalOptions="Center"
                    FontSize="20"
                    TextColor="{StaticResource TextDark}"
                    Text="{Binding EditorTicket.Untracked.Title}"/>

                <!-- Action Panel Layout -->
                <HorizontalStackLayout
                    Grid.Row="0"
                    Grid.Column="1"
                    HorizontalOptions="End"
                    VerticalOptions="Center">
                    <!-- Quick-Print Button -->
                    <Button
                        x:Name="QuickPrintButton"
                        Clicked="OnPrintTicketEditorButtonClicked"
                        Text="Print"
                        FontSize="20"
                        WidthRequest="100"
                        HeightRequest="40"
                        HorizontalOptions="Start"
                        VerticalOptions="Center">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroupList>
                                <VisualStateGroup x:Name="GreenStates">
                                    <VisualState x:Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Property="Style" Value="{StaticResource GreenNormalStyle}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Property="Style" Value="{StaticResource GreenDisabledStyle}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Property="Style" Value="{StaticResource GreenPressedStyle}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Property="Style" Value="{StaticResource GreenPointerOverStyle}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateGroupList>
                        </VisualStateManager.VisualStateGroups>
                    </Button>

                    <!-- Actions Button -->
                    <ImageButton
                        x:Name="TicketActionsButton"
                        Clicked="OnTicketActionsButtonClicked"
                        Margin="0"
                        Source="dots_horizontal.png"
                        WidthRequest="50"
                        HeightRequest="50"
                        HorizontalOptions="End"
                        VerticalOptions="Center"
                        CornerRadius="100"
                        ToolTipProperties.Text="Label Actions">
                        <ImageButton.Behaviors>
                            <toolkit:IconTintColorBehavior TintColor="{StaticResource Neutral-Black}"/>
                        </ImageButton.Behaviors>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroupList>
                                <VisualStateGroup x:Name="TransparentStates">
                                    <VisualState x:Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Property="Style" Value="{StaticResource TransparentNormalStyle}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Property="Style" Value="{StaticResource TransparentDisabledStyle}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Property="Style" Value="{StaticResource TransparentPressedStyle}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Property="Style" Value="{StaticResource TransparentPointerOverStyle}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateGroupList>
                        </VisualStateManager.VisualStateGroups>
                    </ImageButton>
                </HorizontalStackLayout>
            </Grid>

            <!-- Scrolling Body Panel -->
            <ScrollView
                Grid.Row="1"
                x:Name="TicketEditorMenuBody"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                BackgroundColor="{StaticResource Neutral-White}">
                <VerticalStackLayout>
                    <!-- Initial Production Info Header Layout -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Title Row -->
                            <RowDefinition Height="Auto"/>
                            <!-- Process Row -->
                            <RowDefinition Height="Auto"/>
                            <!-- Part Row -->
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <!-- Title / Labels Column -->
                            <ColumnDefinition Width="Auto"/>
                            <!-- Process / Part Column -->
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Ticket Title Layout -->
                        <HorizontalStackLayout
                            Grid.Row="0"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Margin="20,20,0,10">
                            <!-- Title Label -->
                            <Label
                                HorizontalOptions="Start"
                                VerticalOptions="Center"
                                FontSize="24"
                                FontAttributes="Bold"
                                TextColor="{StaticResource Primary-20}"
                                Text="Initial Production Data"/>
                            <!-- Info Button -->
                            <ImageButton
                                x:Name="InitialProductionDataInfoButton"
                                VerticalOptions="Center"
                                HorizontalOptions="Center"
                                HeightRequest="30"
                                MinimumHeightRequest="30"
                                WidthRequest="30"
                                MinimumWidthRequest="30"
                                CornerRadius="30"
                                Source="information.png"
                                ToolTipProperties.Text="Enter the Initial Production information in this area                                                        ________________________________________________________                                                        NOTE: This should be the Lot Information of the FIRST Operator to produce Parts in this Basket.                                                        ________________________________________________________                                                        To add Parts from a different shift to this Label, click the 'Add Partial Basket' Button.">
                                <ImageButton.Behaviors>
                                    <toolkit:IconTintColorBehavior TintColor="{StaticResource Neutral-Black}"/>
                                </ImageButton.Behaviors>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroupList>
                                        <VisualStateGroup x:Name="TransparentStates">
                                            <VisualState x:Name="Normal">
                                                <VisualState.Setters>
                                                    <Setter Property="Style" Value="{StaticResource TransparentNormalStyle}"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Disabled">
                                                <VisualState.Setters>
                                                    <Setter Property="Style" Value="{StaticResource TransparentDisabledStyle}"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Pressed">
                                                <VisualState.Setters>
                                                    <Setter Property="Style" Value="{StaticResource TransparentPressedStyle}"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="PointerOver">
                                                <VisualState.Setters>
                                                    <Setter Property="Style" Value="{StaticResource TransparentPointerOverStyle}"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateGroupList>
                                </VisualStateManager.VisualStateGroups>
                            </ImageButton>
                        </HorizontalStackLayout>
                        
                        <!-- Process/Part Information Layout -->
                        <Grid
                            Grid.Row="1"
                            Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Process Label -->
                            <Label
                                Grid.Row="0"
                                Grid.Column="0"
                                FontSize="20"
                                TextColor="{StaticResource TextDark}"
                                Margin="20,0,0,0"
                                HorizontalOptions="Start"
                                VerticalOptions="Start"
                                Text="{Binding EditorTicket.Untracked.Process.FullName, StringFormat='Process: {0}'}"/>
                            <!-- Part Number Label -->
                            <Label
                                Grid.Row="0"
                                Grid.Column="1"
                                FontSize="20"
                                TextColor="{StaticResource TextDark}"
                                Margin="40,0,0,0"
                                HorizontalOptions="Start"
                                VerticalOptions="Start"
                                Text="{Binding EditorTicket.Untracked.Part.PartNumber, StringFormat='Part: {0}'}"/>
                            <!-- Part Name Label -->
                            <Label
                                Grid.Row="1"
                                Grid.Column="1"
                                FontSize="20"
                                TextColor="{StaticResource TextDark}"
                                Margin="85,0,0,20"
                                HorizontalOptions="Start"
                                VerticalOptions="Start"
                                Text="{Binding EditorTicket.Untracked.Part.PartName}"/>
                        </Grid>
                    </Grid>

                    <!-- Process/Part Separator Bar -->
                    <BoxView
                        Margin="0"
                        HeightRequest="1"
                        HorizontalOptions="Fill"
                        VerticalOptions="End"
                        BackgroundColor="{StaticResource Neutral-20}"/>

                    <!-- Production Data Fields Layout -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Date / Shift / Operator Row (Constant 3) -->
                            <!-- These Controls are all Disabled by Default -->
                            <RowDefinition Height="Auto"/>
                            <!-- Quantity / JBK / Lot Row (Max 3) -->
                            <!-- Dynamically Show Depending on Requirements -->
                            <RowDefinition Height="Auto"/>
                            <!-- Die / Deburr JBK / Model / Heat Row (Max 2) -->
                            <!-- Dynamically Show Depending on Requirements -->
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <!-- Production Date Column -->
                            <ColumnDefinition Width="Auto"/>
                            <!-- Production Shift Column -->
                            <ColumnDefinition Width="Auto"/>
                            <!-- Production Operator Column -->
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Date Control -->
                        <HorizontalStackLayout
                            Grid.Row="0"
                            Grid.Column="0"
