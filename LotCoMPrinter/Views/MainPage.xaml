<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:Datasources="clr-namespace:LotCoMPrinter.Models.Datasources"
             xmlns:ViewModels="clr-namespace:LotCoMPrinter.ViewModels"
             x:DataType="ViewModels:MainPageViewModel"
             x:Class="LotCoMPrinter.Views.MainPage">

    <!-- Customize NavigationPage Bar and Properties -->
    <NavigationPage.HasBackButton>
        <x:Boolean>False</x:Boolean>
    </NavigationPage.HasBackButton>
    <NavigationPage.HasNavigationBar>
        <x:Boolean>False</x:Boolean>
    </NavigationPage.HasNavigationBar>

    <!-- Main Layout Grid (Active Ticket and Open Tickets Columns) -->
    <Grid>
        <Grid.RowDefinitions>
            <!-- Window Header Row -->
            <RowDefinition Height="Auto"/>
            <!-- Main Layout Row -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <!-- Active Print Ticket Column -->
            <ColumnDefinition Width="*"/>
            <!-- Open Print Tickets Panel Column -->
            <ColumnDefinition Width="{Binding Options.OpenPrintTicketsPanelWidth}"/>
        </Grid.ColumnDefinitions>
        
        <!-- Window Header -->
        <HorizontalStackLayout
            Grid.Row="0"
            Grid.Column="0"
            IsVisible="{Binding Options.IsWindowHeaderShown}">
            <VerticalStackLayout>
                <Label
                    Margin="20,10,0,0"
                    HorizontalOptions="Start"
                    VerticalOptions="Center"
                    FontSize="20"
                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                    Text="{Binding Options.WindowHeaderLabelText}"/>
                <Label
                    Margin="20,10,0,0"
                    HorizontalOptions="Start"
                    VerticalOptions="Center"
                    FontSize="14"
                    TextColor="{AppThemeBinding Light=Black, Dark=White}"
                    Text="Click 'Start New Label' to create a new Label or open In-Progress Labels by clicking the arrow button below."/>
            </VerticalStackLayout>
        </HorizontalStackLayout>

        <!-- Start New Label Button -->
        <Button
            x:Name="StartNewLabelButton"
            Clicked="OnStartNewLabelButtonClicked"
            IsVisible="{Binding Options.IsWindowHeaderShown}"
            Grid.Row="1"
            Grid.Column="0"
            Margin="20,0,0,10"
            HorizontalOptions="Start"
            VerticalOptions="End"
            Text="Start New Label"/>

        <!-- ScrollView for Active Print Ticket Display -->
        <ScrollView
            Grid.Row="1"
            Grid.Column="0"
            IsVisible="{Binding Options.HasActivePrintTicket}"> <!-- "{Binding Options.HasActivePrintTicket}" -->
            <!-- Layout Grid -->
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Basic Label Information Input Row -->
                    <RowDefinition Height="Auto"/>
                    <!-- Separator Row -->
                    <RowDefinition Height="10"/>
                    <!-- First Partial Production Dataset Input Row -->
                    <RowDefinition Height="Auto"/>
                    <!-- Separator Row -->
                    <RowDefinition Height="10"/>
                    <!-- Second Partial Production Dataset Input Row -->
                    <RowDefinition Height="Auto"/>
                    <!-- Separator Row -->
                    <RowDefinition Height="10"/>
                    <!-- Add Partial Production Dataset Button Row -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <!-- Main Layout Column -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- Basic Label Information Layout Grid -->
                <Grid
                    Grid.Row="0"
                    Grid.Column="0">
                    <Grid.RowDefinitions>
                        <!-- Header Row -->
                        <RowDefinition Height="Auto"/>
                        <!-- Process Input Row -->
                        <RowDefinition Height="Auto"/>
                        <!-- Part Input Row -->
                        <RowDefinition Height="Auto"/>
                        <!-- Production Date Input Row -->
                        <RowDefinition Height="Auto"/>
                        <!-- Shift / Quantity / Operator Input Row -->
                        <RowDefinition Height="Auto"/>
                        <!-- Variable Fields Input Row -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <!-- Process / Part / Production Date / Shift / Variable Fields Input Column -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- /  /  / Quantity / Variable Fields Input Column -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- /  /  / Operator / Variable Fields Input Column -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- Header Label -->
                    <Label 
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="10,5,5,15"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        FontSize="20"
                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                        Text="{Binding ActivePrintTicket.Title, StringFormat='Input for Label: {0}'}"/>
                    <!-- Process Label -->
                    <Label
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        x:Name="ProcessLabel"
                        FontSize="14"
                        TextColor="{StaticResource Secondary}"
                        Margin="10,10,0,10"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        WidthRequest="250"
                        MinimumWidthRequest="250"
                        Text="{Binding ActivePrintTicket.Process.FullName, StringFormat='Process: {0}'}"/>
                    <!-- Part Label -->
                    <Label
                        Grid.Row="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        x:Name="PartLabel"
                        FontSize="14"
                        TextColor="{StaticResource Secondary}"
                        Margin="10,10,0,40"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        WidthRequest="250"
                        MinimumWidthRequest="250"
                        Text="{Binding ActivePrintTicket.Part.GetInfo, StringFormat='Part: {0}'}"/>
                    <!-- Production Date Input Horizontal Layout -->
                    <HorizontalStackLayout
                        Grid.Row="3"
                        Grid.Column="0"
                        Grid.ColumnSpan="2">
                        <!-- Input Label -->
                        <Label
                            x:Name="ProductionDateLabel"
                            Margin="10,0,0,10"
                            HorizontalOptions="Start"
                            VerticalOptions="Center"
                            WidthRequest="75"
                            MinimumWidthRequest="75"
                            Text="Production Date"/>
                        <!-- Input DatePicker Control and Border -->
                        <Border
                            x:Name="ProductionDateControl"
                            Margin="10,5,5,12"
                            HorizontalOptions="Start"
                            VerticalOptions="Start"
                            WidthRequest="125"
                            HeightRequest="40"
                            Stroke="{StaticResource Gray500}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10,10,10,10"
                            Background="#00000000">
                            <DatePicker
                                x:Name="ProductionDatePicker"
                                IsEnabled="False"
                                Date="{Binding ActivePrintTicket.ProductionDate}"/>
                        </Border>
                    </HorizontalStackLayout>
                    <!-- Quantity / Shift / Operator Input Grid Layout -->
                    <Grid
                        Grid.Row="4"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Margin="10">
                        <Grid.RowDefinitions>
                            <!-- Main Row -->
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>    
                        <Grid.ColumnDefinitions>
                            <!-- Shift Input Column -->
                            <ColumnDefinition Width="200"/>
                            <!-- Quantity Input Column -->
                            <ColumnDefinition Width="200"/>
                            <!-- Operator Input Column -->
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>
                        <!-- Shift Number Input Layout -->
                        <HorizontalStackLayout
                            Grid.Row="0"
                            Grid.Column="0">
                            <!-- Input Label -->
                            <Label
                                Margin="0,0,0,10"
                                x:Name="ShiftLabel"
                                HorizontalOptions="Start"
                                VerticalOptions="Center"
                                WidthRequest="75"
                                MinimumWidthRequest="75"
                                Text="Shift"/>
                            <!-- Input Entry Control and Border -->
                            <Border
                                x:Name="ShiftControl"
                                Margin="10,5,5,12"
                                HorizontalOptions="Start"
                                VerticalOptions="Start"
                                WidthRequest="100"
                                HeightRequest="40"
                                Stroke="{StaticResource Gray500}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10,10,10,10"
                                Background="#00000000">
                                <Picker
                                    x:Name="ShiftPicker"
                                    IsEnabled="False"
                                    SelectedItem="{Binding ActivePrintTicket.ProductionShift}">
                                    <Picker.ItemsSource>
                                        <x:Array Type="{x:Type x:Int32}">
                                            <x:Int32>1</x:Int32>
                                            <x:Int32>2</x:Int32>
                                            <x:Int32>3</x:Int32>
                                        </x:Array>
                                    </Picker.ItemsSource>
                                </Picker>
                            </Border>
                        </HorizontalStackLayout>
                        <!-- Quantity Input Layout -->
                        <HorizontalStackLayout
                            Grid.Row="0"
                            Grid.Column="1">
                            <!-- Input Label -->
                            <Label
                                x:Name="QuantityLabel"
                                Margin="10,0,0,10"
                                HorizontalOptions="Start"
                                VerticalOptions="Center"
                                WidthRequest="75"
                                MinimumWidthRequest="75"
                                Text="Quantity"/>
                            <!-- Input Entry Control and Border -->
                            <Border
                                x:Name="QuantityControl"
                                Margin="10,5,5,12"
                                HorizontalOptions="Start"
                                VerticalOptions="Start"
                                WidthRequest="100"
                                HeightRequest="40"
                                Stroke="{StaticResource Gray500}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10,10,10,10"
                                Background="#00000000">
                                <Entry
                                    x:Name="QuantityEntry"/>
                            </Border>
                        </HorizontalStackLayout>
                        <!-- Operator Input Layout -->
                        <HorizontalStackLayout
                            Grid.Row="0"
                            Grid.Column="2">
                            <!-- Input Label -->
                            <Label
                                x:Name="OperatorLabel"
                                Margin="10,0,0,10"
                                HorizontalOptions="Start"
                                VerticalOptions="Center"
                                WidthRequest="75"
                                MinimumWidthRequest="75"
                                Text="Operator"/>
                            <!-- Input Entry Control and Border -->
                            <Border
                                x:Name="OperatorControl"
                                Margin="10,5,5,12"
                                HorizontalOptions="Start"
                                VerticalOptions="Start"
                                WidthRequest="100"
                                HeightRequest="40"
                                Stroke="{StaticResource Gray500}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10,10,10,10"
                                Background="#00000000">
                                <Entry
                                    x:Name="OperatorEntry"
                                    IsEnabled="False"
                                    Text="{Binding ActivePrintTicket.ProductionOperator}"
                                    MaxLength="3"/>
                            </Border>
                        </HorizontalStackLayout>
                    </Grid>
                    <!-- Variable Fields Input Horizontal Layout -->
                    <HorizontalStackLayout
                        Grid.Row="5"
                        Grid.Column="0"
                        Grid.ColumnSpan="3">
                        <!-- JBK Input Layout -->
                        <HorizontalStackLayout
                            IsVisible="{Binding ActivePrintTicket.Process.RequiredFields.JBKNumber}">
                            <!-- JBK Input Label -->
                            <Label
                                x:Name="JBKNumberLabel"
                                Margin="10,0,0,10"
                                HorizontalOptions="Start"
                                VerticalOptions="Center"
                                WidthRequest="75"
                                MinimumWidthRequest="75"
                                Text="JBK #"/>
                            <!-- JBK Input Entry Control and Border -->
                            <Border
                                x:Name="JBKNumberControl"
                                Margin="10,5,5,12"
                                HorizontalOptions="Start"
                                VerticalOptions="Start"
                                WidthRequest="150"
                                HeightRequest="40"
                                Stroke="{StaticResource Gray500}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10,10,10,10"
                                Background="#00000000">
                                <Entry
                                    x:Name="JBKNumberEntry"
                                    IsEnabled="{Binding ActivePrintTicket.IsPassThrough}"
                                    Text="{Binding ActivePrintTicket.VariableFields.JBKNumber}"
                                    MaxLength="3"/>
                            </Border>
                        </HorizontalStackLayout>
                        <!-- Lot Input Layout -->
                        <HorizontalStackLayout
                            IsVisible="{Binding ActivePrintTicket.Process.RequiredFields.LotNumber}">
                            <!-- Lot Input Label -->
                            <Label
                                x:Name="LotNumberLabel"
                                Margin="10,0,0,10"
                                HorizontalOptions="Start"
                                VerticalOptions="Center"
                                WidthRequest="75"
                                MinimumWidthRequest="75"
                                Text="Lot #"/>
                            <!-- Lot Input Entry Control and Border -->
                            <Border
                                x:Name="LotNumberControl"
                                Margin="10,5,5,12"
                                HorizontalOptions="Start"
                                VerticalOptions="Start"
                                WidthRequest="150"
                                HeightRequest="40"
                                Stroke="{StaticResource Gray500}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10,10,10,10"
                                Background="#00000000">
                                <Entry
                                    x:Name="LotNumberEntry"
                                    IsEnabled="{Binding ActivePrintTicket.IsPassThrough}"
                                    Text="{Binding ActivePrintTicket.VariableFields.LotNumber}"
                                    MaxLength="9"/>
                            </Border>
                        </HorizontalStackLayout>
                        <!-- Deburr JBK Input Layout -->
                        <HorizontalStackLayout
                            IsVisible="{Binding ActivePrintTicket.Process.RequiredFields.DeburrJBKNumber}">
                            <!-- Input Label -->
                            <Label
                                x:Name="DeburrJBKNumberLabel"
                                Margin="10,0,0,10"
                                HorizontalOptions="Start"
                                VerticalOptions="Center"
                                WidthRequest="75"
                                MinimumWidthRequest="75"
                                Text="Deburr   JBK #"/>
                            <!-- Input Entry Control and Border -->
                            <Border
                                x:Name="DeburrJBKNumberControl"
                                Margin="10,5,5,12"
                                HorizontalOptions="Start"
                                VerticalOptions="Start"
                                WidthRequest="150"
                                HeightRequest="40"
                                Stroke="{StaticResource Gray500}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10,10,10,10"
                                Background="#00000000">
                                <Entry
                                    x:Name="DeburrJBKNumberEntry"
                                    Text="{Binding ActivePrintTicket.VariableFields.DeburrJBKNumber}"
                                    MaxLength="3"/>
                            </Border>
                        </HorizontalStackLayout>
                        <!-- Die Number Input Layout -->
                        <HorizontalStackLayout
                            IsVisible="{Binding ActivePrintTicket.Process.RequiredFields.DieNumber}">
                            <!-- Input Label -->
                            <Label
                                x:Name="DieNumberLabel"
                                Margin="10,0,0,10"
                                HorizontalOptions="Start"
                                VerticalOptions="Center"
                                WidthRequest="75"
                                MinimumWidthRequest="75"
                                Text="Die #"/>
                            <!-- Input Entry Control and Border -->
                            <Border
                                x:Name="DieNumberControl"
                                Margin="10,5,5,12"
                                HorizontalOptions="Start"
                                VerticalOptions="Start"
                                WidthRequest="150"
                                HeightRequest="40"
                                Stroke="{StaticResource Gray500}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10,10,10,10"
                                Background="#00000000">
                                <Entry
                                    x:Name="DieNumberEntry"
                                    Text="{Binding ActivePrintTicket.VariableFields.DieNumber}"
                                    MaxLength="3"/>
                            </Border>
                        </HorizontalStackLayout>
                        <!-- Model Input Layout -->
                        <HorizontalStackLayout
                            IsVisible="{Binding ActivePrintTicket.Process.RequiredFields.ModelNumber}">
                            <!-- Input Label -->
                            <Label
                                x:Name="ModelNumberLabel"
                                Margin="10,0,0,10"
                                HorizontalOptions="Start"
                                VerticalOptions="Center"
                                WidthRequest="75"
                                MinimumWidthRequest="75"
                                Text="Model #"/>
                            <!-- Input Entry Control and Border -->
                            <Border
                                x:Name="ModelNumberControl"
                                Margin="10,5,5,12"
                                HorizontalOptions="Start"
                                VerticalOptions="Start"
                                WidthRequest="150"
                                HeightRequest="40"
                                Stroke="{StaticResource Gray500}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10,10,10,10"
                                Background="#00000000">
                                <Entry
                                    x:Name="ModelNumberEntry"
                                    Text="{Binding ActivePrintTicket.VariableFields.ModelNumber}"
                                    MaxLength="3"/>
                            </Border>
                        </HorizontalStackLayout>
                        <!-- Heat Number Input Layout -->
                        <HorizontalStackLayout
                            IsVisible="{Binding ActivePrintTicket.Process.RequiredFields.HeatNumber}">
                            <!-- Input Label -->
                            <Label
                                x:Name="HeatNumberLabel"
                                Margin="10,0,0,10"
                                HorizontalOptions="Start"
                                VerticalOptions="Center"
                                WidthRequest="75"
                                MinimumWidthRequest="75"
                                Text="Heat #"/>
                            <!-- Input Entry Control and Border -->
                            <Border
                                x:Name="HeatNumberControl"
                                Margin="10,5,5,12"
                                HorizontalOptions="Start"
                                VerticalOptions="Start"
                                WidthRequest="150"
                                HeightRequest="40"
                                Stroke="{StaticResource Gray500}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10,10,10,10"
                                Background="#00000000">
                                <Entry
                                    x:Name="HeatNumberEntry"
                                    Text="{Binding ActivePrintTicket.VariableFields.HeatNumber}"/>
                            </Border>
                        </HorizontalStackLayout>
                    </HorizontalStackLayout>
                </Grid>
                <!-- Separator Bar -->
                <BoxView
                    Grid.Row="1"
                    Grid.Column="0"
                    HeightRequest="1"
                    HorizontalOptions="Fill"
                    VerticalOptions="Center"
                    BackgroundColor="{StaticResource Gray500}"/>
                <!-- First Partial Production Dataset Grid Layout -->
                <Grid
                    Grid.Row="2"
                    Grid.Column="0"
                    Margin="40,10,0,0"
                    IsVisible="{Binding ActivePrintTicket.HasFirstPartialDataSet}">
                    <Grid.RowDefinitions>
                        <!-- Header Row -->
                        <RowDefinition Height="Auto"/>
                        <!-- Inputs Row -->
                        <RowDefinition Height="Auto"/>
                        <!-- Buttons Row -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <!-- Shift Input Column -->
                        <ColumnDefinition Width="200"/>
                        <!-- Quantity Input Column -->
                        <ColumnDefinition Width="200"/>
                        <!-- Operator Input Column -->
                        <ColumnDefinition Width="200"/>
                        <!-- Margin Column -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- Header Label -->
                    <Label
                        Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Margin="0,0,0,10"
                        FontSize="16"
                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                        Text="Partial Production Data #1"/>
                    <!-- Shift Number Input Layout -->
                    <HorizontalStackLayout
                        Grid.Row="1"
                        Grid.Column="0">
                        <!-- Input Label -->
                        <Label
                            Margin="0,0,0,10"
                            x:Name="FirstPartialDataSetShiftLabel"
                            HorizontalOptions="Start"
                            VerticalOptions="Center"
                            WidthRequest="75"
                            MinimumWidthRequest="75"
                            Text="Shift"/>
                        <!-- Input Entry Control and Border -->
                        <Border
                            x:Name="FirstPartialDataSetShiftControl"
                            Margin="10,5,5,12"
                            HorizontalOptions="Start"
                            VerticalOptions="Start"
                            WidthRequest="100"
                            HeightRequest="40"
                            Stroke="{StaticResource Gray500}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10,10,10,10"
                            Background="#00000000">
                            <Picker
                                x:Name="FirstPartialDataSetShiftPicker"
                                SelectedItem="{Binding ActivePrintTicket.FirstPartialDataSet.Shift}">
                                <Picker.ItemsSource>
                                    <x:Array Type ="{x:Type x:Int32}">
                                        <x:Int32>1</x:Int32>
                                        <x:Int32>2</x:Int32>
                                        <x:Int32>3</x:Int32>
                                    </x:Array>
                                </Picker.ItemsSource>
                            </Picker>
                        </Border>
                    </HorizontalStackLayout>
                    <!-- Quantity Input Layout -->
                    <HorizontalStackLayout
                        Grid.Row="1"
                        Grid.Column="1">
                        <!-- Input Label -->
                        <Label
                            x:Name="FirstPartialDataSetQuantityLabel"
                            Margin="10,0,0,10"
                            HorizontalOptions="Start"
                            VerticalOptions="Center"
                            WidthRequest="75"
                            MinimumWidthRequest="75"
                            Text="Quantity"/>
                        <!-- Input Entry Control and Border -->
                        <Border
                            x:Name="FirstPartialDataSetQuantityControl"
                            Margin="10,5,5,12"
                            HorizontalOptions="Start"
                            VerticalOptions="Start"
                            WidthRequest="100"
                            HeightRequest="40"
                            Stroke="{StaticResource Gray500}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10,10,10,10"
                            Background="#00000000">
                            <Entry
                                x:Name="FirstPartialDataSetQuantityEntry"
                                Text="{Binding ActivePrintTicket.FirstPartialDataSet.Quantity}"/>
                        </Border>
                    </HorizontalStackLayout>
                    <!-- Operator Input Layout -->
                    <HorizontalStackLayout
                        Grid.Row="1"
                        Grid.Column="2">
                        <!-- Input Label -->
                        <Label
                            x:Name="FirstPartialDataSetOperatorLabel"
                            Margin="10,0,0,10"
                            HorizontalOptions="Start"
                            VerticalOptions="Center"
                            WidthRequest="75"
                            MinimumWidthRequest="75"
                            Text="Operator"/>
                        <!-- Input Entry Control and Border -->
                        <Border
                            x:Name="FirstPartialDataSetOperatorControl"
                            Margin="10,5,5,12"
                            HorizontalOptions="Start"
                            VerticalOptions="Start"
                            WidthRequest="100"
                            HeightRequest="40"
                            Stroke="{StaticResource Gray500}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10,10,10,10"
                            Background="#00000000">
                            <Entry
                                x:Name="FirstPartialDataSetOperatorEntry"
                                Text="{Binding ActivePrintTicket.FirstPartialDataSet.Operator}"
                                MaxLength="3"/>
                        </Border>
                    </HorizontalStackLayout>
                    <!-- Buttons Layout -->
                    <HorizontalStackLayout
                        Grid.Row="3"
                        Grid.Column="0"
                        Grid.ColumnSpan="2">
                        <!-- Print Button -->
                        <Button
                            Text="Print Label"
                            Margin="0,10,20,20"
                            WidthRequest="100"
                            HeightRequest="40"
                            HorizontalOptions="Start"
                            VerticalOptions="Center"/>
                        <!-- Remove Button -->
                        <Button
                            x:Name="RemoveFirstPartialProductionDataSetButton"
                            Clicked="OnRemoveFirstPartialProductionDataSetButtonClicked"
                            Text="- Remove"
                            Margin="0,10,20,20"
                            WidthRequest="100"
                            HeightRequest="40"
                            HorizontalOptions="Start"
                            VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Grid>
                <!-- Separator Bar -->
                <BoxView
                    Grid.Row="3"
                    Grid.Column="0"
                    IsVisible="{Binding ActivePrintTicket.HasFirstPartialDataSet}"
                    HeightRequest="1"
                    HorizontalOptions="Fill"
                    VerticalOptions="Center"
                    BackgroundColor="{StaticResource Gray500}"/>
                <!-- Second Partial Production Dataset Grid Layout -->
                <Grid
                    Grid.Row="4"
                    Grid.Column="0"
                    Margin="40,10,0,0"
                    IsVisible="{Binding ActivePrintTicket.HasSecondPartialDataSet}">
                    <Grid.RowDefinitions>
                        <!-- Header Row -->
                        <RowDefinition Height="Auto"/>
                        <!-- Inputs Row -->
                        <RowDefinition Height="Auto"/>
                        <!-- Buttons Row -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <!-- Shift Input Column -->
                        <ColumnDefinition Width="200"/>
                        <!-- Quantity Input Column -->
                        <ColumnDefinition Width="200"/>
                        <!-- Operator Input Column -->
                        <ColumnDefinition Width="200"/>
                        <!-- Margin Column -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- Header Label -->
                    <Label
                        Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Margin="0,0,0,10"
                        FontSize="16"
                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                        Text="Partial Production Data #2"/>
                    <!-- Shift Number Input Layout -->
                    <HorizontalStackLayout
                        Grid.Row="1"
                        Grid.Column="0">
                        <!-- Input Label -->
                        <Label
                            Margin="0,0,0,10"
                            x:Name="SecondPartialDataSetShiftLabel"
                            HorizontalOptions="Start"
                            VerticalOptions="Center"
                            WidthRequest="75"
                            MinimumWidthRequest="75"
                            Text="Shift"/>
                        <!-- Input Entry Control and Border -->
                        <Border
                            x:Name="SecondPartialDataSetShiftControl"
                            Margin="10,5,5,12"
                            HorizontalOptions="Start"
                            VerticalOptions="Start"
                            WidthRequest="100"
                            HeightRequest="40"
                            Stroke="{StaticResource Gray500}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10,10,10,10"
                            Background="#00000000">
                            <Picker
                                x:Name="SecondPartialDataSetShiftPicker"
                                SelectedItem="{Binding ActivePrintTicket.SecondPartialDataSet.Shift}">
                                <Picker.ItemsSource>
                                    <x:Array Type ="{x:Type x:Int32}">
                                        <x:Int32>1</x:Int32>
                                        <x:Int32>2</x:Int32>
                                        <x:Int32>3</x:Int32>
                                    </x:Array>
                                </Picker.ItemsSource>
                            </Picker>
                        </Border>
                    </HorizontalStackLayout>
                    <!-- Quantity Input Layout -->
                    <HorizontalStackLayout
                        Grid.Row="1"
                        Grid.Column="1">
                        <!-- Input Label -->
                        <Label
                            x:Name="SecondPartialDataSetQuantityLabel"
                            Margin="10,0,0,10"
                            HorizontalOptions="Start"
                            VerticalOptions="Center"
                            WidthRequest="75"
                            MinimumWidthRequest="75"
                            Text="Quantity"/>
                        <!-- Input Entry Control and Border -->
                        <Border
                            x:Name="SecondPartialDataSetQuantityControl"
                            Margin="10,5,5,12"
                            HorizontalOptions="Start"
                            VerticalOptions="Start"
                            WidthRequest="100"
                            HeightRequest="40"
                            Stroke="{StaticResource Gray500}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10,10,10,10"
                            Background="#00000000">
                            <Entry
                                x:Name="SecondPartialDataSetQuantityEntry"
                                Text="{Binding ActivePrintTicket.SecondPartialDataSet.Quantity}"/>
                        </Border>
                    </HorizontalStackLayout>
                    <!-- Operator Input Layout -->
                    <HorizontalStackLayout
                        Grid.Row="1"
                        Grid.Column="2">
                        <!-- Input Label -->
                        <Label
                            x:Name="SecondPartialDataSetOperatorLabel"
                            Margin="10,0,0,10"
                            HorizontalOptions="Start"
                            VerticalOptions="Center"
                            WidthRequest="75"
                            MinimumWidthRequest="75"
                            Text="Operator"/>
                        <!-- Input Entry Control and Border -->
                        <Border
                            x:Name="SecondPartialDataSetOperatorControl"
                            Margin="10,5,5,12"
                            HorizontalOptions="Start"
                            VerticalOptions="Start"
                            WidthRequest="100"
                            HeightRequest="40"
                            Stroke="{StaticResource Gray500}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10,10,10,10"
                            Background="#00000000">
                            <Entry
                                x:Name="SecondPartialDataSetOperatorEntry"
                                Text="{Binding ActivePrintTicket.SecondPartialDataSet.Operator}"
                                MaxLength="3"/>
                        </Border>
                    </HorizontalStackLayout>
                    <!-- Buttons Layout -->
                    <HorizontalStackLayout
                        Grid.Row="3"
                        Grid.Column="0"
                        Grid.ColumnSpan="2">
                        <!-- Print Button -->
                        <Button
                            Text="Print Label"
                            Margin="0,10,20,20"
                            WidthRequest="100"
                            HeightRequest="40"
                            HorizontalOptions="Start"
                            VerticalOptions="Center"/>
                        <!-- Remove Button -->
                        <Button
                            x:Name="RemoveSecondPartialProductionDataSetButton"
                            Clicked="OnRemoveSecondPartialProductionDataSetButtonClicked"
                            Text="- Remove"
                            Margin="0,10,20,20"
                            WidthRequest="100"
                            HeightRequest="40"
                            HorizontalOptions="Start"
                            VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Grid>
                <!-- Add Partial Production Dataset Button -->
                <Button
                    x:Name="AddPartialProductionDatasetButton"
                    Grid.Row="7"
                    Grid.Column="0"
                    Clicked="OnAddPartialProductionDataSetButtonClicked"
                    IsVisible="{Binding ActivePrintTicket.HasSpace}"
                    Margin="10,0,0,0"
                    Padding="0"
                    WidthRequest="100"
                    HeightRequest="40"
                    HorizontalOptions="Start"
                    VerticalOptions="Center"
                    Text="+ Add Partial"/>
                <!-- Close Active Ticket Display Button -->
                <Button
                    x:Name="CloseActivePrintTicketButton"
                    Clicked="OnCloseActivePrintTicketButtonClicked"
                    Grid.Row="7"
                    Grid.Column="2"
                    Margin="0,0,10,10"
                    Padding="0"
                    WidthRequest="100"
                    HeightRequest="40"
                    HorizontalOptions="End"
                    VerticalOptions="Start"
                    Text="Save &amp; Close"/>
            </Grid>
        </ScrollView>

        <!-- Grid for Open Print Tickets Panel -->
        <Grid
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="1">
            <Grid.RowDefinitions>
                <!-- Header Row -->
                <RowDefinition Height="100"/>
                <!-- Body (ListView) Row -->
                <RowDefinition Height="*"/>
                <!-- Body Collapse/Raise Button Row -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <!-- Single Column for the Panel -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Panel Header Label -->
            <Label
                x:Name="OpenPrintTicketsHeaderLabel"
                IsVisible="{Binding Options.IsOpenPrintTicketsPanelShown}"
                Grid.Row="0"
                Grid.Column="0"
                Margin="0,20,0,0"
                Text="In-Process Labels"
                HorizontalOptions="Center"
                VerticalOptions="Start"/>
            <!-- Panel Body List -->
            <ListView
                x:Name="OpenPrintTicketsListView"
                IsVisible="{Binding Options.IsOpenPrintTicketsPanelShown}"
                SelectedItem="{Binding Options.SelectedPrintTicketIndex}"
                ItemsSource="{Binding OpenPrintTickets}"
                Grid.Row="1"
                Grid.Column="0"
                Margin="10"
                HorizontalOptions="Start"
                VerticalOptions="Start">
                <ListView.ItemTemplate>
                    <DataTemplate
                        x:DataType="Datasources:PrintTicket">
                        <!-- Configurable ListView Grid Layout -->
                        <ViewCell>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <!-- Process & Date Row -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- Title & Shift Row -->
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <!-- Process / Title Column -->
                                    <ColumnDefinition Width="*"/>
                                    <!-- Date / Shift Column -->
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- Process Label -->
                                <Label 
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="0,5,0,0"
                                    Text="{Binding Process.FullName}"
                                    FontSize="12"
                                    HorizontalOptions="Start"
                                    VerticalOptions="Center"/>
                                <!-- Date Label -->
                                <Label 
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="0,5,0,0"
                                    Text="{Binding ProductionDateNoTime}"
                                    FontSize="12"
                                    HorizontalOptions="End"
                                    VerticalOptions="Center"/>
                                <!-- Title Label -->
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,5,0,0"
                                    Text="{Binding Title}"
                                    FontSize="12"
                                    HorizontalOptions="Start"
                                    VerticalOptions="Center"/>
                                <!-- Shift Label -->
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="0,5,0,0"
                                    Text="{Binding ProductionShift}"
                                    FontSize="12"
                                    HorizontalOptions="End"
                                    VerticalOptions="Center"/>
                                <!-- Bottom Border -->
                                <BoxView
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Margin="0,5,0,0"
                                    HeightRequest="1"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="End"
                                    BackgroundColor="{StaticResource Gray500}"/>
                            </Grid>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <!-- Panel Collapse/Raise Button -->
            <Button
                x:Name="OpenPrintTicketsCollapseButton"
                Clicked="OnOpenPrintTicketsCollapseButtonClicked"
                Margin="0,0,0,10"
                Padding="10"
                Grid.Row="2"
                Grid.Column="0"
                VerticalOptions="End"
                HorizontalOptions="End"
                HeightRequest="30"
                WidthRequest="30"
                CornerRadius="30"
                ImageSource="{AppThemeBinding Light=left_arrow_white.png, Dark=left_arrow_black.png}"/>
            <!-- Panel Left Border -->
            <BoxView
                x:Name="OpenPrintTicketsLeftBorder"
                IsVisible="{Binding Options.IsOpenPrintTicketsPanelShown}"
                Grid.Row="0"
                Grid.RowSpan="3"
                Grid.Column="0"
                WidthRequest="1"
                VerticalOptions="Fill"
                HorizontalOptions="Start"
                Color="{StaticResource Gray500}"/>
        </Grid>
    </Grid>
</ContentPage>

