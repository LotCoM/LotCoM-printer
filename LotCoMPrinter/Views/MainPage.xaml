                            </Border>
                        </HorizontalStackLayout>
                        <!-- Print Button -->
                        <Button
                            Grid.Row="3"
                            Grid.Column="0"
                            Text="Print Label"
                            Margin="20"
                            WidthRequest="100"
                            HeightRequest="40"
                            HorizontalOptions="Start"
                            VerticalOptions="Center"/>
                        <!-- Remove Button -->
                        <Button
                            Grid.Row="3"
                            Grid.Column="3"
                            x:Name="RemoveFirstPartialProductionDataSetButton"
                            Clicked="OnRemoveFirstPartialProductionDataSetButtonClicked"
                            Text="- Remove"
                            Margin="20"
                            WidthRequest="100"
                            HeightRequest="40"
                            HorizontalOptions="End"
                            VerticalOptions="Center">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroupList>
                                    <VisualStateGroup x:Name="RedStates">
                                        <VisualState x:Name="Normal">
                                            <VisualState.Setters>
                                                <Setter Property="Style" Value="{StaticResource RedNormalStyle}"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Property="Style" Value="{StaticResource RedDisabledStyle}"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Property="Style" Value="{StaticResource RedPressedStyle}"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Property="Style" Value="{StaticResource RedPointerOverStyle}"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateGroupList>
                            </VisualStateManager.VisualStateGroups>
                        </Button>
                    </Grid>
                    <!-- Separator Bar -->
                    <BoxView
                        Margin="0"
                        HeightRequest="1"
                        HorizontalOptions="Fill"
                        VerticalOptions="Center"
                        IsVisible="{Binding ActiveTicket.Tracked.HasFirstPartialDataSet}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Foreground}, Dark={StaticResource ForegroundDark}}"/> 
