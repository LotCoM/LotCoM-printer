                                VerticalOptions="Start"
                                WidthRequest="200"
                                HeightRequest="40"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10,10,10,10">
                                <Entry
                                    x:Name="SecondPartialDataSetQuantityEntry"
                                    Text="{Binding ActiveTicket.Tracked.SecondPartialDataSet.Quantity}"/>
                            </Border>
                        </HorizontalStackLayout>
                        <!-- Operator Input Layout -->
                        <HorizontalStackLayout
                            Grid.Row="1"
                            Grid.Column="2">
                            <!-- Input Label -->
                            <Label
                                x:Name="SecondPartialDataSetOperatorLabel"
                                Margin="20,10,10,10"
                                HorizontalOptions="Start"
                                VerticalOptions="Center"
                                WidthRequest="80"
                                MinimumWidthRequest="80"
                                Text="Operator"/>
                            <!-- Input Entry Control and Border -->
                            <Border
                                x:Name="SecondPartialDataSetOperatorControl"
                                Margin="0,10,0,10"
