                    </Grid>
                </VerticalStackLayout>
            </ScrollView>
            <!-- Footer Panel -->
            <HorizontalStackLayout
                Grid.Row="2"
                x:Name="ActivePrintTicketLayoutFooter"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                BackgroundColor="{AppThemeBinding Light={StaticResource Framing}, Dark={StaticResource FramingDark}}">
