                <Button
                    x:Name="AddPartialProductionDatasetButton"
                    Clicked="OnAddPartialProductionDataSetButtonClicked"
                    IsVisible="{Binding ActiveTicket.Tracked.HasSpace}"
                    Margin="20"
                    WidthRequest="125"
                    HeightRequest="40"
                    HorizontalOptions="Start"
                    VerticalOptions="Start"
                    Text="+ Add Partial"/>
            </HorizontalStackLayout>
        </Grid>
    </Grid>
</ContentPage>

