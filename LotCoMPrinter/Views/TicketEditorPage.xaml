                            VerticalOptions="Center"
                            WidthRequest="110"
                            MinimumWidthRequest="110"
                            FontSize="20"
                            Text="Quantity"/>
                        <!-- Input Entry Control and Border -->
                        <Border
                            x:Name="SecondPartialDataSetQuantityControl"
                            Margin="0,15,0,15"
                            HorizontalOptions="Start"
                            VerticalOptions="Center"
                            HeightRequest="40"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 0">
                            <Entry
                                x:Name="SecondPartialDataSetQuantityEntry"
                                Text="{Binding EditorTicket.Tracked.TertiaryData.Quantity.Value}"
                                TextChanged="OnQuantityEntryTextChanged"
                                WidthRequest="150"
                                FontSize="20"/>
                        </Border>
                    </HorizontalStackLayout>

                    <!-- Operator Input Layout -->
                    <HorizontalStackLayout
                        Grid.Row="1"
                        Grid.Column="2">
                        <!-- Input Label -->
                        <Label
                            x:Name="SecondPartialDataSetOperatorLabel"
                            Margin="60,15,0,15"
                            HorizontalOptions="Start"
                            VerticalOptions="Center"
                            WidthRequest="100"
                            MinimumWidthRequest="100"
                            FontSize="20"
                            Text="Operator"/>
                        <!-- Input Entry Control and Border -->
                        <Border
                            x:Name="SecondPartialDataSetOperatorControl"
                            Margin="0,15,0,15"
                            HorizontalOptions="Start"
                            VerticalOptions="Center"
                            HeightRequest="40"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 0">
                            <Entry
                                x:Name="SecondPartialDataSetOperatorEntry"
                                Text="{Binding EditorTicket.Tracked.TertiaryData.Operator.Initials}"
                                TextChanged="OnOperatorEntryTextChanged"
                                MaxLength="3"
                                WidthRequest="150"
                                FontSize="20"/>
                        </Border>
                    </HorizontalStackLayout>
                </Grid>

                <!-- Add Partial Production Dataset Button -->
                <Button
                    x:Name="AddPartialProductionDatasetButton"
                    Clicked="OnAddPartialProductionDataSetButtonClicked"
                    IsVisible="{Binding EditorTicket.Tracked.HasSpace}"
                    Margin="20"
                    WidthRequest="250"
                    HeightRequest="40"
                    HorizontalOptions="Start"
                    VerticalOptions="Start"
                    Text="+ Add Partial Basket"
                    FontSize="18"
                    ToolTipProperties.Text="Create a new set of Partial Production Data to fill out."/>

            </VerticalStackLayout>
        </ScrollView>
        
        <!-- Loading/Transitioning Activity Indicator -->
        <BoxView
            Grid.Row="0"
            Grid.RowSpan="3"
            Grid.Column="0"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"
            IsVisible="{Binding Flags.IsLoading}"
            BackgroundColor="{StaticResource Neutral-LoadingTint}"/>
        <ActivityIndicator
            Grid.Row="0"
            Grid.RowSpan="3"
            Grid.Column="0"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            WidthRequest="400"
            HeightRequest="400"
            x:Name="DataLoadingIndicator"
            Color="{StaticResource Secondary-0}"
            IsEnabled="{Binding Flags.IsLoading}"
            IsVisible="{Binding Flags.IsLoading}"
            IsRunning="{Binding Flags.IsLoading}"/>
    </Grid>
</ContentPage>