<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:views="clr-namespace:LotComPrinter.Views"
               x:DataType="views:BasicPopup"
               x:Class="LotComPrinter.Views.BasicPopup">
    
    <!-- Style the Popup Window -->
    <toolkit:Popup.Resources>
        <Style TargetType="{x:Type views:BasicPopup}">
            <Setter Property="Color" Value="Transparent" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="VerticalOptions" Value="Start" />
            <Setter Property="CanBeDismissedByTappingOutsideOfPopup" Value="False" />
        </Style>
        <!-- RecessedButton Styles -->
        <ResourceDictionary Source="/Resources/Styles/RecessedButton.xaml"/>
    </toolkit:Popup.Resources>
    
    <!-- Main Layout -->
    <Border
        StrokeThickness="1"
        StrokeShape="RoundRectangle 10,10,10,10"
        Stroke="{StaticResource Neutral-40}">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Header Row -->
                <RowDefinition Height="Auto"/>
                <!-- Body Row -->
                <RowDefinition Height="Auto"/>
                <!-- Button (Footer) Row -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <!-- Expand Columns to add more Controls -->
                <ColumnDefinition Width="500"/>
            </Grid.ColumnDefinitions>
            <!-- Add a Border to Fill the Header Row -->
            <Border
                Grid.Row="0"
                Grid.Column="0"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                StrokeThickness="0"
                StrokeShape="Rectangle"
                BackgroundColor="{StaticResource Primary-80}">
                <!-- Add an Error Title Label -->
                <Label
                    x:Name="PopupTitleLabel"
                    HorizontalOptions="Start"
                    VerticalOptions="Center"
                    Margin="15"
                    Text="{Binding Title}"
                    TextColor="{StaticResource TextLight}"
                    FontSize="32"/>
            </Border>
            <!-- Use a ScrollView in the Body to Allow Lengthy Messages -->
            <ScrollView
                Grid.Row="1"
                Grid.Column="0"
                MinimumHeightRequest="50"
                HeightRequest="150">
                <!-- Add a Border to Fill the Body Row -->
                <Border
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill"
                    StrokeThickness="0"
                    StrokeShape="Rectangle"
                    BackgroundColor="{StaticResource Neutral-White}">
                    <!-- Add an Error Message Body Label -->
                    <Label
                        x:Name="PopupMessageLabel"
                        HorizontalOptions="Start"
                        VerticalOptions="Start"
                        Margin="25,5,25,5"
                        Text="{Binding Message}"
                        FontSize="20"
                        LineBreakMode="WordWrap"
                        TextColor="{StaticResource TextDark}"/>
                </Border>
            </ScrollView>
            <!-- Add a Border to Fill the Footer Row -->
            <Border
                Grid.Row="2"
                Grid.Column="0"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                StrokeThickness="0"
                StrokeShape="Rectangle"
                BackgroundColor="{StaticResource Primary-80}">
                <!-- Add an OK Button -->
                <Button
                    x:Name="ConfirmationButton"
                    Clicked="OnConfirmation"
                    HorizontalOptions="End"
                    VerticalOptions="End"
                    WidthRequest="75"
                    HeightRequest="40"
                    Grid.Row="2"
                    Grid.Column="0"
                    Margin="10"
                    Text="OK"/>
            </Border>
        </Grid>
    </Border>
    
</toolkit:Popup>