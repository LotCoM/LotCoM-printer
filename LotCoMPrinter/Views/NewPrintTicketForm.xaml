<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:Views="clr-namespace:LotCoMPrinter.Views"
               xmlns:ViewModels="clr-namespace:LotCoMPrinter.ViewModels"
               xmlns:Datasources="clr-namespace:LotCoMPrinter.Models.Datasources"
               x:DataType="ViewModels:NewPrintTicketFormViewModel"
               x:Class="LotCoMPrinter.Views.NewPrintTicketForm">
    
    <!-- Style the Popup Window -->
    <toolkit:Popup.Resources>
        <Style TargetType="{x:Type Views:NewPrintTicketForm}">
            <Setter Property="Color" Value="{StaticResource OffBlack}" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="VerticalOptions" Value="Start" />
            <Setter Property="CanBeDismissedByTappingOutsideOfPopup" Value="False" />
        </Style>
        <!-- RecessedButton Styles -->
        <ResourceDictionary Source="/Resources/Styles/RecessedButton.xaml"/>
        <!-- GreenButton Styles -->
        <ResourceDictionary Source="/Resources/Styles/GreenButton.xaml"/>
        <!-- RedButton Styles -->
        <ResourceDictionary Source="/Resources/Styles/RedButton.xaml"/>
    </toolkit:Popup.Resources>

    <!-- Main Layout -->
    <Border
        StrokeThickness="1"
        StrokeShape="RoundRectangle 10,10,10,10"
        Stroke="{AppThemeBinding Light={StaticResource Foreground}, Dark={StaticResource ForegroundDark}}">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Title Row -->
                <RowDefinition Height="Auto"/>
                <!-- Message Row -->
                <RowDefinition Height="Auto"/>
                <!-- Process Input Row -->
                <RowDefinition Height="Auto"/>
                <!-- Part Input Row -->
                <RowDefinition Height="Auto"/>
                <!-- Date, Shift, Operator Input Row -->
                <RowDefinition Height="Auto"/>
                <!-- Fill Row -->
                <RowDefinition Height="*"/>
                <!-- Buttons Row -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <!-- Main Column -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Title Fill -->
            <HorizontalStackLayout
                Grid.Row="0"
                Grid.Column="0"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                BackgroundColor="{AppThemeBinding Light={StaticResource Framing}, Dark={StaticResource FramingDark}}">
                <!-- Title Label -->
                <Label
                    x:Name="PopupTitleLabel"
                    HorizontalOptions="Start"
                    VerticalOptions="Center"
                    Margin="10,20,0,20"
                    Text="Open New Label Ticket"
                    FontSize="20"
                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>
            </HorizontalStackLayout>
            
            <!-- Message Fill -->
            <HorizontalStackLayout
                Grid.Row="1"
                Grid.Column="0"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                BackgroundColor="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource BackgroundDark}}">
                <!-- Message Label -->
                <Label
                    x:Name="PopupMessageLabel"
                    HorizontalOptions="Start"
                    VerticalOptions="Start"
                    Margin="20"
                    Text="Enter basic information for this new Label:"
                    TextColor="{AppThemeBinding Light={StaticResource PrimaryText}, Dark={StaticResource PrimaryTextDark}}"/>
            </HorizontalStackLayout>

            <!-- Process Input Layout-->
            <HorizontalStackLayout
                Grid.Row="2"
                Grid.Column="0"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                BackgroundColor="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource BackgroundDark}}">
                <!-- Input Label -->
                <Label
                    x:Name="ProcessLabel"
                    Margin="20,10,0,10"
                    HorizontalOptions="Start"
                    VerticalOptions="Center"
                    WidthRequest="75"
                    MinimumWidthRequest="75"
                    Text="Process"/>
                <!-- Input Picker Control and Border -->
                <Border
                    x:Name="ProcessControl"
                    Margin="0,10,0,10"
                    HorizontalOptions="Start"
                    VerticalOptions="Start"
                    WidthRequest="250"
                    HeightRequest="40"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10,10,10,10">
                    <Picker
                        x:Name="ProcessPicker"
                        ItemsSource="{Binding AllProcesses}"
                        ItemDisplayBinding="{Binding FullName}"
                        SelectedIndex="{Binding SelectedProcessIndex}"
                        SelectedIndexChanged="OnProcessPickerSelectedIndexChanged">
                    </Picker>
                </Border>
                <!-- Originator/Pass-through Indicator Card -->
                <Border
                    x:Name="ProcessTypeCard"
                    Margin="5"
                    HorizontalOptions="Start"
                    VerticalOptions="Center"
                    HeightRequest="25"
                    WidthRequest="85"
                    Stroke="#00ACACAC"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 10,10,10,10"
                    Background="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                    <Label
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        x:Name="ProcessTypeLabel"
                        Text="{Binding Process.Type}"
                        TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}"
                        FontSize="11"/>
                </Border>
            </HorizontalStackLayout>

            <!-- Part Input Horizontal Layout -->
            <HorizontalStackLayout
                Grid.Row="3"
                Grid.Column="0"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                BackgroundColor="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource BackgroundDark}}">
                <!-- Input Label -->
                <Label
                    x:Name="PartLabel"
                    Margin="20,10,0,10"
                    HorizontalOptions="Start"
                    VerticalOptions="Center"
                    WidthRequest="75"
                    MinimumWidthRequest="75"
                    Text="Part"/>
                <!-- Input Picker Control and Border -->
                <Border
                    x:Name="PartControl"
                    Margin="0,10,0,10"
                    HorizontalOptions="Start"
                    VerticalOptions="Start"
                    WidthRequest="250"
                    HeightRequest="40"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10,10,10,10">
                    <Picker
                        x:Name="PartPicker"
                        ItemsSource="{Binding SelectedProcessParts}"
                        ItemDisplayBinding="{Binding GetInfo}"
                        SelectedIndex="{Binding SelectedPartIndex}"
                        SelectedIndexChanged="OnPartPickerSelectedIndexChanged"/>
                </Border>
            </HorizontalStackLayout>

            <!-- Date, Shift, Operator Input Layout -->
            <HorizontalStackLayout
                Grid.Row="4"
                Grid.Column="0"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                BackgroundColor="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource BackgroundDark}}">
                <!-- Production Date Input Horizontal Layout -->
                <HorizontalStackLayout>
                    <!-- Input Label -->
                    <Label
                        x:Name="ProductionDateLabel"
                        Margin="20,10,0,10"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        WidthRequest="75"
                        MinimumWidthRequest="75"
                        Text="Date"/>
                    <!-- Input DatePicker Control and Border -->
                    <Border
                        x:Name="ProductionDateControl"
                        Margin="0,10,0,10"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        WidthRequest="125"
                        HeightRequest="40"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10,10,10,10">
                        <DatePicker
                            x:Name="ProductionDatePicker"
                            WidthRequest="120"
                            Date="{Binding ProductionDate}"/>
                    </Border>
                </HorizontalStackLayout>

                <!-- Shift Number Input Layout -->
                <HorizontalStackLayout
                    Grid.Row="5"
                    Grid.Column="0">
                    <!-- Input Label -->
                    <Label
                        Margin="20,10,0,10"
                        x:Name="ShiftLabel"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        WidthRequest="50"
                        MinimumWidthRequest="50"
                        Text="Shift"/>
                    <!-- Input Entry Control and Border -->
                    <Border
                        x:Name="ShiftControl"
                        Margin="0,10,0,10"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        WidthRequest="75"
                        HeightRequest="40"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10,10,10,10">
                        <Picker
                            x:Name="ShiftPicker"
                            SelectedItem="{Binding ProductionShift}">
                            <Picker.ItemsSource>
                                <x:Array Type ="{x:Type Datasources:Shift}">
                                    <Datasources:Shift>First</Datasources:Shift>
                                    <Datasources:Shift>Second</Datasources:Shift>
                                    <Datasources:Shift>Third</Datasources:Shift>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>
                    </Border>
                </HorizontalStackLayout>
                
                <!-- Operator Input Layout -->
                <HorizontalStackLayout>
                    <!-- Input Label -->
                    <Label
                        x:Name="OperatorLabel"
                        Margin="20,10,0,10"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        WidthRequest="75"
                        MinimumWidthRequest="75"
                        Text="Operator"/>
                    <!-- Input Entry Control and Border -->
                    <Border
                        x:Name="OperatorControl"
                        Margin="0,10,20,10"
                        HorizontalOptions="Start"
                        VerticalOptions="Start"
                        WidthRequest="75"
                        HeightRequest="40"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10,10,10,10">
                        <Entry
                            x:Name="OperatorEntry"
                            Text="{Binding ProductionOperator}"
                            MaxLength="3"/>
                    </Border>
                </HorizontalStackLayout>
            </HorizontalStackLayout>

            <HorizontalStackLayout
                Grid.Row="6"
                Grid.Column="0"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                BackgroundColor="{AppThemeBinding Light={StaticResource Framing}, Dark={StaticResource FramingDark}}"/>
            <!-- Cancel Button -->
            <Button
                Grid.Row="6"
                Grid.Column="0"
                x:Name="CancelButton"
                Clicked="OnCancelButtonClicked"
                HorizontalOptions="Start"
                VerticalOptions="Center"
                Margin="10"
                Text="Cancel">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="RedStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="Style" Value="{StaticResource RedNormalStyle}"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="Style" Value="{StaticResource RedDisabledStyle}"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Style" Value="{StaticResource RedPressedStyle}"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="Style" Value="{StaticResource RedPointerOverStyle}"/>
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>
            </Button>
            <!-- Confirm Button -->
            <Button
                Grid.Row="6"
                Grid.Column="0"
                x:Name="ConfirmButton"
                Clicked="OnConfirmButtonClicked"
                HorizontalOptions="End"
                VerticalOptions="Center"
                Margin="10"
                Text="Create Label">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="GreenStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="Style" Value="{StaticResource GreenNormalStyle}"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="Style" Value="{StaticResource GreenDisabledStyle}"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Style" Value="{StaticResource GreenPressedStyle}"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="Style" Value="{StaticResource GreenPointerOverStyle}"/>
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>
            </Button>
        </Grid>
    </Border>
</toolkit:Popup>