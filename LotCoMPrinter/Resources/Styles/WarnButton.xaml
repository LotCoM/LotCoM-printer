<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Style x:Key="WarnNormalStyle" TargetType="Button">
        <Setter Property="TextColor" Value="{StaticResource TextLight}"/>
        <Setter Property="BackgroundColor" Value="{StaticResource Warn-0}"/>                    
    </Style>
    <Style x:Key="WarnDisabledStyle" TargetType="Button">
        <Setter Property="TextColor" Value="{StaticResource TextLightDisabled}" />
        <Setter Property="BackgroundColor" Value="{StaticResource Warn-40}" />
    </Style>
    <Style x:Key="WarnPressedStyle" TargetType="Button">
        <Setter Property="TextColor" Value="{StaticResource TextLight}" />
        <Setter Property="BackgroundColor" Value="{StaticResource Warn-40}" />
    </Style>
    <Style x:Key="WarnPointerOverStyle" TargetType="Button">
        <Setter Property="TextColor" Value="{StaticResource TextLight}"/>
        <Setter Property="BackgroundColor" Value="{StaticResource Warn-20}"/>
    </Style>
</ResourceDictionary>