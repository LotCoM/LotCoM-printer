<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- Highlight Colors -->
    <Color x:Key="Primary">#FF5AA8F0</Color>
    <Color x:Key="PrimaryDark">#FF3B94E7</Color>
    <Color x:Key="PrimaryDarkText">#242424</Color>
    <Color x:Key="Secondary">#F6C6AD</Color>
    <Color x:Key="SecondaryDarkText">#242424</Color>
    <Color x:Key="Tertiary">#FFDBAA5C</Color>
    <Color x:Key="LightGreen">#FF61F28F</Color>
    <Color x:Key="LightRed">#FFEE8787</Color>
    <Color x:Key="Green">#FF4AC671</Color>
    <Color x:Key="Red">#FFE05757</Color>
    
    <!-- Light Theme UI Colors -->
    <Color x:Key="PrimaryText">Black</Color>
    <Color x:Key="SecondaryText">DarkSlateGray</Color>
    <Color x:Key="DisabledPrimaryText">#919191</Color>  <!-- Gray400 -->
    <Color x:Key="DisabledSecondaryText">LightSlateGray</Color>
    <Color x:Key="Hovered">#DAEDFF</Color>
    <Color x:Key="HoveredRecessed">#A7B4C1</Color>
    <Color x:Key="TitleBar">Gainsboro</Color>
    <Color x:Key="Foreground">Gainsboro</Color>
    <Color x:Key="Framing">WhiteSmoke</Color>
    <Color x:Key="Background">White</Color>
    <Color x:Key="DisabledBackground">LightGray</Color>

    <!-- Dark Theme UI Colors -->
    <Color x:Key="PrimaryTextDark">White</Color>
    <Color x:Key="SecondaryTextDark">LightSlateGray</Color>
    <Color x:Key="DisabledPrimaryTextDark">DarkGray</Color>
    <Color x:Key="DisabledSecondaryTextDark">Gray</Color>
    <Color x:Key="HoveredDark">#5D646C</Color>
    <Color x:Key="HoveredRecessedDark">#4F5357</Color>
    <Color x:Key="TitleBarDark">#404040</Color>         <!-- Gray600 -->
    <Color x:Key="ForegroundDark">#404040</Color>       <!-- Gray600 -->
    <Color x:Key="FramingDark">#1f1f1f</Color>          <!-- OffBlack -->
    <Color x:Key="BackgroundDark">Black</Color>
    <Color x:Key="DisabledBackgroundDark">#1f1f1f</Color>   <!-- OffBlack -->

      <!-- Default MAUI Colors -->

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>