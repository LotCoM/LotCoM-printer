<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Style x:Key="GreenNormalStyle" TargetType="Button">
        <Setter Property="TextColor" Value="{StaticResource TextLight}"/>
        <Setter Property="BackgroundColor" Value="{StaticResource Success-0}"/>                    
    </Style>
    <Style x:Key="GreenDisabledStyle" TargetType="Button">
        <Setter Property="TextColor" Value="{StaticResource TextLightDisabled}" />
        <Setter Property="BackgroundColor" Value="{StaticResource Success-40}" />
    </Style>
    <Style x:Key="GreenPressedStyle" TargetType="Button">
        <Setter Property="TextColor" Value="{StaticResource TextLight}" />
        <Setter Property="BackgroundColor" Value="{StaticResource Success-40}" />
    </Style>
    <Style x:Key="GreenPointerOverStyle" TargetType="Button">
        <Setter Property="TextColor" Value="{StaticResource TextLight}"/>
        <Setter Property="BackgroundColor" Value="{StaticResource Success-20}"/>
    </Style>
</ResourceDictionary>