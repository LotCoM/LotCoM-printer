<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Style x:Key="GreenNormalStyle" TargetType="Button">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryText}, Dark={StaticResource PrimaryTextDark}}"/>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Framing}, Dark={StaticResource FramingDark}}"/>                    
    </Style>
    <Style x:Key="GreenDisabledStyle" TargetType="Button">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DisabledPrimaryText}, Dark={StaticResource DisabledPrimaryTextDark}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource DisabledBackground}, Dark={StaticResource DisabledBackgroundDark}}" />
    </Style>
    <Style x:Key="GreenPressedStyle" TargetType="Button">
        <Setter Property="TextColor" Value="{StaticResource Black}"/>
        <Setter Property="BackgroundColor" Value="{StaticResource Green}"/>
    </Style>
    <Style x:Key="GreenPointerOverStyle" TargetType="Button">
        <Setter Property="TextColor" Value="{StaticResource Black}"/>
        <Setter Property="BackgroundColor" Value="{StaticResource LightGreen}"/>
    </Style>
</ResourceDictionary>