<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Style x:Key="RedNormalStyle" TargetType="Button">
        <Setter Property="TextColor" Value="{StaticResource TextLight}"/>
        <Setter Property="BackgroundColor" Value="{StaticResource Danger-0}"/>                    
    </Style>
    <Style x:Key="RedDisabledStyle" TargetType="Button">
        <Setter Property="TextColor" Value="{StaticResource TextLightDisabled}" />
        <Setter Property="BackgroundColor" Value="{StaticResource Danger-40}" />
    </Style>
    <Style x:Key="RedPressedStyle" TargetType="Button">
        <Setter Property="TextColor" Value="{StaticResource TextLight}" />
        <Setter Property="BackgroundColor" Value="{StaticResource Danger-40}" />
    </Style>
    <Style x:Key="RedPointerOverStyle" TargetType="Button">
        <Setter Property="TextColor" Value="{StaticResource TextLight}"/>
        <Setter Property="BackgroundColor" Value="{StaticResource Danger-20}"/>
    </Style>
</ResourceDictionary>