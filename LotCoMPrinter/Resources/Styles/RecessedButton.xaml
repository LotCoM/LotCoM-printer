<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Style x:Key="RecessedNormalStyle" TargetType="Button">
        <Setter Property="TextColor" Value="{StaticResource TextDark}"/>
        <Setter Property="BackgroundColor" Value="{StaticResource Neutral-40}"/>                         
    </Style>
    <Style x:Key="RecessedDisabledStyle" TargetType="Button">
        <Setter Property="TextColor" Value="{StaticResource TextLightDisabled}"/>
        <Setter Property="BackgroundColor" Value="{StaticResource Neutral-60}"/>      
    </Style>
    <Style x:Key="RecessedPressedStyle" TargetType="Button">
        <Setter Property="TextColor" Value="{StaticResource TextDark}"/>
        <Setter Property="BackgroundColor" Value="{StaticResource Neutral-20}"/>      
    </Style>
    <Style x:Key="RecessedPointerOverStyle" TargetType="Button">
        <Setter Property="TextColor" Value="{StaticResource TextDark}"/>
        <Setter Property="BackgroundColor" Value="{StaticResource Neutral-20}"/>      
    </Style>
</ResourceDictionary>